 cash500={name="500 Eddie note",category="CURRENCY",tagCategory="currency",shapeTag="1x1",shape={{0,0}},glyph="500",rarity="common",denomination=500,base=500,wholesale=500,color={170,183,128},description="One loose note. Does not stack in stock."},
 cash1000={name="1000 Eddie note",category="CURRENCY",tagCategory="currency",shapeTag="1x1",shape={{0,0}},glyph="1000",rarity="common",denomination=1000,base=1000,wholesale=1000,color={170,183,128},description="One loose note. Does not stack in stock."},

 printer1={name="Makeshift printer",category="MACHINE",tagCategory="machine",shapeTag="1x3",shape={{0,0},{0,1},{0,2}},glyph="PR",rarity="common",machine="printer",inputColumns=1,inputRows=3,outputCapacity=1,seconds=240,base=120,wholesale=60,color={103,154,166},description="Prints unlaundered 100-Eddie notes from paper and a Mint Press."},
 printer2={name="Commercial printer",category="MACHINE",tagCategory="machine",shapeTag="2x3",shape={{0,0},{1,0},{0,1},{1,1},{0,2},{1,2}},glyph="PR",rarity="uncommon",machine="printer",inputColumns=2,inputRows=3,outputCapacity=3,seconds=180,base=450,wholesale=225,color={103,154,166},description="Prints unlaundered 100-Eddie notes from paper and a Mint Press."},
