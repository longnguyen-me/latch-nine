return table.freeze({Definitions=table.freeze(items),Order=table.freeze({"blank1","blankL","blank2","blank3","blank4","blank9","wallet1","wallet2","wallet3","printer1","printer2","printer3","printer4","laundry","mintPress","paperlow","papermid","paperhigh"})})
