      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Scene</string>
          <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Scene = {}
local C = Color3.fromRGB

local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, neon: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.Position = position; p.Color = color
	p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.CastShadow = false
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(parent: Instance, text: string, size: Vector3, position: Vector3, color: Color3)
	local board = part(parent, "Sign", size, position, C(15, 24, 32))
	local gui = Instance.new("SurfaceGui"); gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(600, 120); gui.LightInfluence = 0; gui.Parent = board
	local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1; label.Text = text; label.Font = Enum.Font.Code
	label.TextScaled = true; label.TextColor3 = color; label.Parent = gui
	local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12); pad.Parent = label
end

function Scene.character(parent: Instance, position: Vector3, color: Color3): Model
	local model = Instance.new("Model"); model.Name = "PixelMerchant"
	local root = part(model, "Root", Vector3.new(0.1, 0.1, 0.1), position, color); root.Transparency = 1
	model.PrimaryPart = root
	local function block(name: string, x: number, y: number, w: number, h: number, c: Color3, z: number?)
		part(model, name, Vector3.new(w, h, 0.4), position + Vector3.new(x, y, z or 0), c)
	end
	block("BootL", -0.45, 0.22, 0.7, 0.45, C(21, 27, 35)); block("BootR", 0.45, 0.22, 0.7, 0.45, C(21, 27, 35))
	block("LegL", -0.4, 0.9, 0.55, 1.1, C(43, 57, 69)); block("LegR", 0.4, 0.9, 0.55, 1.1, C(43, 57, 69))
	block("Coat", 0, 2, 1.65, 1.5, color); block("Shirt", 0, 2.1, 0.35, 1.1, C(32, 42, 49), 0.23)
	block("ArmL", -1.02, 1.9, 0.42, 1.25, color); block("ArmR", 1.02, 1.9, 0.42, 1.25, color)
	block("HandL", -1.02, 1.16, 0.42, 0.36, C(203, 160, 128)); block("HandR", 1.02, 1.16, 0.42, 0.36, C(203, 160, 128))
	block("Head", 0, 3.35, 1.35, 1.2, C(203, 160, 128)); block("Hair", 0, 3.95, 1.5, 0.38, C(27, 32, 43))
	block("EyeL", -0.32, 3.4, 0.18, 0.18, C(20, 27, 33), 0.24); block("EyeR", 0.32, 3.4, 0.18, 0.18, C(20, 27, 33), 0.24)
	block("Badge", 0.48, 2.25, 0.25, 0.32, C(236, 192, 108), 0.24)
	model.Parent = parent
	return model
end

function Scene.move(model: Model, destination: Vector3, seconds: number): () -> ()
	local cf = Instance.new("CFrameValue"); cf.Value = model:GetPivot()
	local connection = cf.Changed:Connect(function(value: CFrame) if model.Parent then model:PivotTo(value) end end)
	local tween = TweenService:Create(cf, TweenInfo.new(seconds, Enum.EasingStyle.Linear), {Value = CFrame.new(destination)})
	local finished = false
	local function clean()
		if finished then return end
		finished = true; connection:Disconnect(); tween:Cancel(); cf:Destroy()
	end
	tween.Completed:Once(function() clean() end)
	tween:Play()
	return clean
end

function Scene.build(parent: Instance, origin: Vector3, name: string): Model
 local m = Instance.new("Model"); m.Name = name
 local function p(n: string,x: number,y: number,z: number,sx: number,sy: number,sz: number,color: Color3,neon: boolean?)
  return part(m,n,Vector3.new(sx,sy,sz),origin+Vector3.new(x,y,z),color,neon)
 end
 -- The viewer stands inside the booth. The service opening looks out onto a corridor.
 p("Hall darkness",-2,10,-6,20,12,0.5,C(14,20,31))
 for i=1,7 do
  p("Hall rib",-11+i*2.5,10,-5.6,0.25,11,0.35,C(36,44,54))
  p("Hall light",-11+i*2.5,14.2,-5.2,1,0.1,0.2,C(83,133,133),true)
 end
 p("Left booth wall",-18,9,0,14,20,0.7,C(48,64,68))
 p("Right booth wall",16,9,0,18,20,0.7,C(48,64,68))
 p("Ceiling beam",0,17,0,50,4,0.7,C(45,41,52))
 p("Lower booth wall",-2,2,0,20,6,0.6,C(48,64,68))
 for _,x in ipairs({-11.5,7.5}) do
  p("Window upright",x,10,0.7,0.7,11,0.8,C(103,83,79))
  p("Window inner trim",x+(if x<0 then 0.42 else -0.42),10,1.05,0.12,10.7,0.15,C(191,151,97),true)
 end
 p("Window lintel",-2,15.5,0.7,20,0.65,0.8,C(103,83,79))
 p("Service sill",-2,4.5,2,20,0.5,5,C(109,113,100))
 p("Counter surface",0,2.8,5,48,0.8,8,C(91,108,108))
 p("Counter front",0,-0.3,8.5,48,5.6,0.8,C(40,47,58))
 for x=-22,22,4 do
  p("Worn counter edge",x,3.23,8.9,1.5,0.07,0.15,C(150,144,119))
 end
 -- Mounted interaction surfaces face the seller. Counter tray is tilted toward the viewer.
 local function board(name: string,x: number,y: number,z: number,w: number,h: number,tilt: number?)
  local b=p(name,x,y,z,w,h,0.35,C(26,34,44));b.CanQuery=true
  if tilt then b.Orientation=Vector3.new(tilt,0,0) end
  return b
 end
 board("InventoryBoard",0,-1.8,9.3,23,10)
 board("VisitorBoard",12,11.1,2,13,5.9)
 local controls=Instance.new("Model");controls.Name="InteractionControls";controls.Parent=m
 local sleep=p("SleepingBag",-17,0.5,11,5,0.5,3,C(70,74,105));sleep.CanQuery=true
 local shutter=p("ShopToggle",-12,5.8,6,3,1.4,0.4,C(68,128,121));shutter.CanQuery=true
 local function control(name: string,y: number,z: number,h: number,color: Color3)
  local base=board(name,-14,y,z,4.6,h);base.Parent=controls
  local face=Instance.new("SurfaceGui");face.Name="EditOutline";face.Face=Enum.NormalId.Back
  face.CanvasSize=Vector2.new(320,100);face.LightInfluence=0;face.Parent=base
  local border=Instance.new("Frame");border.Name="Border";border.Size=UDim2.fromScale(1,1)
  border.BackgroundTransparency=1;border.BorderSizePixel=5;border.BorderColor3=color;border.Parent=face
 end
 control("RegisterBox",4.9,7.4,2.8,C(241,194,116))
 control("NextCustomerButton",2.8,9.2,1.1,C(111,218,196))
 control("DismissCustomerButton",1.5,9.2,1.1,C(242,127,120))
 local function marker(name: string,x: number,y: number,z: number)
  local value=p(name,x,y,z,0.2,0.2,0.2,C(113,209,182));value.Transparency=1
 end
 marker("ViewTarget",0,4.5,0)
 local mount=p("CameraMount",0,4.5,70,1.5,1,0.3,C(111,218,196));mount.Transparency=0.25
 marker("VisitorStand",-2,5.2,-1.8)
 marker("VisitorEntry",-14,5.2,-1.8)
 marker("VisitorExit",14,5.2,-1.8)
 p("Status terminal",-17,15.5,0.8,8,2.8,0.6,C(35,42,49))
 p("Status glow",-17,15.5,1.15,7.3,2.1,0.12,C(72,169,146),true)
 local money=p("MoneyDisplay",-17,12.4,0.9,8,3.1,0.6,C(18,36,39))
 local display=Instance.new("SurfaceGui");display.Name="CashSurface";display.Face=Enum.NormalId.Back
 display.CanvasSize=Vector2.new(640,240);display.LightInfluence=0;display.Parent=money
 local balance=Instance.new("TextLabel");balance.Name="Balance";balance.Size=UDim2.fromScale(1,1)
 balance.BackgroundTransparency=1;balance.Text="--- EDDIES";balance.Font=Enum.Font.Code
 balance.TextScaled=true;balance.TextColor3=C(111,231,192);balance.Parent=display
 sign(m,"NIGHT MARKET",Vector3.new(6,1,0.3),origin+Vector3.new(-2,16.7,1.1),C(222,186,113))
 for i=1,4 do
  p("Cable vertical",-23+i*0.3,10,0.6,0.1,18,0.2,C(28+i*5,34,40))
 end
 p("Pipe vertical",21,10,0.7,0.5,17,0.6,C(89,100,99))
 p("Pipe elbow",18,17,0.7,6,0.5,0.6,C(89,100,99))
 p("Radio",-17,4,5,4,2,2,C(44,50,62))
 p("Radio screen",-17,4.2,6.1,2.8,0.65,0.1,C(102,183,154),true)
 p("Desk keypad",-9,3.5,6,3,0.45,2.4,C(43,55,64))
 for x=0,3 do for y=0,2 do
  p("Key",-10+x*0.6,3.8,5.2+y*0.55,0.32,0.1,0.32,C(137,177,164))
 end end
 p("Receipt machine",16,4.1,4.7,6,2.3,3,C(110,120,111))
 p("Receipt paper",16,6,4.5,3.7,2.8,0.2,C(216,196,143))
 for i=1,4 do p("Receipt line",16,5.3+i*0.4,4.64,2.8,0.08,0.04,C(129,118,89)) end
 p("Desk lamp base",11,3.4,4.5,2.5,0.3,2,C(45,50,57))
 p("Desk lamp stem",11,6,4.5,0.25,5,0.25,C(75,80,79))
 p("Desk lamp shade",10.5,8.4,4.5,3,0.6,2,C(57,71,73))
 p("Lamp strip",10.5,8.05,4.5,2.5,0.1,1.5,C(225,196,126),true)
 for i=1,3 do p("Stock"..i,-21+(i-1)*2,4,5,1.2,1.2,1.2,C(63,72,77)) end
 m.Parent=parent;return m
end

-- Clone the saved Studio shop. Only offset the clone; never rebuild or modify the template.
function Scene.spawn(template: Model?,parent: Instance,origin: Vector3,name: string): Model
 if not template then return Scene.build(parent,origin,name) end
 local stage=template:Clone();stage.Name=name
 for _,object in ipairs(stage:GetDescendants()) do
  if object:IsA("BasePart") then object.CFrame=object.CFrame+origin end
 end
 stage.Parent=parent;return stage
end

function Scene.cash(stage: Model,amount: number)
 local part=stage:FindFirstChild("MoneyDisplay",true)
 local surface=if part then part:FindFirstChild("CashSurface") else nil
 local label=if surface then surface:FindFirstChild("Balance") else nil
 if label and label:IsA("TextLabel") then
  local value=tostring(amount).." EDDIES"
  if label.Text~=value then label.Text=value end
 end
end

function Scene.stock(stage: Model, counts: {number}, colors: {{number}})
	for i, count in ipairs(counts) do
		local stock = stage:FindFirstChild("Stock" .. i,true) :: Part?
		if stock then stock.Color = if count > 0 then C(colors[i][1], colors[i][2], colors[i][3]) else C(63, 72, 77) end
	end
end
return Scene
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
export type Item = {id: string, kind: string, paid: number, condition: number, authentic: boolean, restricted: boolean, inspected: boolean, qualityTag: string, gridX: number, gridY: number, rotation: number}
export type Profile = {version: number, legacyRows: number, gridRevision: number, cash: number, day: number, inventory: {Item}, reputation: number, upgrade: number, revenue: number, costs: number, tradeProfit: number, visits: number, aidDay: number, receipts: {string}}
export type Customer = {id: string, name: string, personality: string, faction: string, kind: string?, requestTag: string?, dialogue: string?, mode: string, goods: {any}, basket: {any}, basketRevision: number, quote: any?, offer: number, budget: number, tolerance: number, patience: number, state: string, color: {number}, itemId: string?, deadline: number?}
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Wallet</string>
          <string name="Source"><![CDATA[--!strict
local Wallet={}
Wallet.Denominations={1,5,10,25,50,100,250,500,1000}
Wallet.Sizes={{2,3},{3,3},{3,4},{4,4}}
Wallet.Prices={0,150,350,700}
Wallet.Rarities={"Common","Uncommon","Rare","Legendary"}
function Wallet.stacks(cash: number,tier: number): {any}
 local capacity=math.min(#Wallet.Denominations,Wallet.Sizes[tier+1][1]*Wallet.Sizes[tier+1][2])
 local remaining=cash;local counts={}
 for i=capacity,1,-1 do
  local denomination=Wallet.Denominations[i]
  counts[i]=math.floor(remaining/denomination);remaining%=denomination
 end
 local result={}
 for i=1,capacity do table.insert(result,{denomination=Wallet.Denominations[i],count=counts[i]}) end
 return result
end
return Wallet
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">LatchNine</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CustomerService</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
local Tags=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").ItemTags)
local Customers = {}
local archetypes = {
	{name = "Mara Venn", personality = "Patient", faction = "Dock Union", tolerance = 1.1, patience = 4, color = {86, 181, 177}},
	{name = "Pell Rusk", personality = "Frugal", faction = "Lower Decks", tolerance = 0.96, patience = 3, color = {207, 156, 87}},
	{name = "Inspector Sable", personality = "Exacting", faction = "Transit Watch", tolerance = 1.04, patience = 2, color = {126, 145, 184}},
	{name = "Ivo Coil", personality = "Impulsive", faction = "Free Relay", tolerance = 1.22, patience = 2, color = {176, 113, 174}},
}
function Customers.create(p: any, rules: any, rng: Random): any
	local archetype = archetypes[rng:NextInteger(1, #archetypes)]
	local buyer=p.visits%2==1
	local requested=if buyer then Tags.BuyerCategories[rng:NextInteger(1,#Tags.BuyerCategories)] else nil
	local item=nil
	if requested then
	 for _,unit in ipairs(p.inventory) do if rules.category(unit)==requested then item=unit;break end end
	end
	local value=if item then rules.value(item) else 0
	local line=if requested then "I'm looking for "..Tags.Categories[requested].name:lower()..". Do you have anything?" else "I've got some unmarked goods. Looking to sell."

	return {id = HttpService:GenerateGUID(false), name = archetype.name, personality = archetype.personality,
		faction = archetype.faction, tolerance = archetype.tolerance, color = archetype.color,
		mode = if buyer then "Buyer" else "Seller", goods = {}, basket = {}, basketRevision = 0, quote = nil,
		dialogue=line,requestTag=requested, kind = if item then item.kind else nil, itemId = if item then item.id else nil,
		budget = if buyer then rules.categoryBudget(requested) else 0,
		offer = math.max(1, math.floor(value * 0.86)), patience = archetype.patience, state = "WalkToCounter"}
end
return Customers
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Scene = require(Shared.Scene)
local Tags = require(Shared.ItemTags)
local Wallet = require(Shared.Wallet)
local Grid = require(Shared.Grid)(Config, Items.Definitions)
local Rules = require(script.Parent.Rules)(Config, Items.Definitions, Grid, Tags)
local trayConfig: any = table.clone(Config);trayConfig.GridColumns=Config.TradeColumns;trayConfig.GridBaseRows=Config.TradeRows;trayConfig.GridRowsPerUpgrade=0
local TrayGrid = require(Shared.Grid)(trayConfig, Items.Definitions)
local Trade = require(script.Parent.TradeService)(Config, Items.Definitions, Rules, Grid, TrayGrid, Wallet)
local Persistence = require(script.Parent.Persistence)
local Customers = require(script.Parent.CustomerService)
Players.CharacterAutoLoads = false
local shopTemplate = workspace:FindFirstChild("ShopTemplate") or workspace:FindFirstChild("StagePreview")
if shopTemplate then shopTemplate.Name="ShopTemplate";shopTemplate.Parent=game:GetService("ServerStorage") end
local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = RS
local action = Instance.new("RemoteEvent"); action.Name = "Action"; action.Parent = remotes
local state = Instance.new("RemoteEvent"); state.Name = "State"; state.Parent = remotes
local sessions: {[Player]: any} = {}
local loading: {[Player]: boolean} = {}
local slots: {[number]: boolean} = {}
local closing = false
local rng = Random.new()
local function publicItem(item: any): any
 local out: any = {criminality=item.criminality or "none",id=item.id,kind=item.kind,inspected=item.inspected,paid=item.paid,gridX=item.gridX,gridY=item.gridY,rotation=item.rotation,qualityTag=item.qualityTag or Tags.DefaultQuality,categoryTag=Items.Definitions[item.kind].tagCategory,marketPrice=Rules.value(item)}
 if item.inspected then
  out.condition=item.condition; out.authentic=item.authentic
  out.restricted=item.restricted; out.value=Rules.value(item)
 end
 return out
end
local function makeOffer(kind: string,p: any): any
 local qualityRoll=rng:NextInteger(1,100)
 local item={id=Http:GenerateGUID(false),kind=kind,rarity=Items.Definitions[kind].rarity,
  criminality=if rng:NextNumber()<0.08 then "low" else "none",paid=0,qualityTag=Tags.QualityOrder[if qualityRoll<=20 then 1 elseif qualityRoll>80 then 3 else 2],condition=rng:NextInteger(65,100),
  authentic=rng:NextNumber()>0.17,restricted=false,inspected=false}
 local price=math.max(8,math.floor(Rules.value(item)*0.58))
 if p.reputation>=Config.ReputationDiscountAt then price=math.max(1,price-2) end
 return {item=item,price=price}
end
local function push(player: Player,message: string?, moveAck: number?, moveOk: boolean?)
 local s=sessions[player]
 if not s or s.closed then return end
 local inventory,counts,colors={},{},{}
 for _,item in ipairs(s.profile.inventory) do table.insert(inventory,publicItem(item)) end
 for _,kind in ipairs(Items.Order) do
  local count=0
  for _,item in ipairs(s.profile.inventory) do if item.kind==kind then count+=1 end end
  table.insert(counts,count); table.insert(colors,Items.Definitions[kind].color)
 end
 Scene.stock(s.stage,counts,colors)
 Scene.cash(s.stage,s.profile.cash)
 local customer: any=nil
 if s.customer then
  local c=s.customer
  local goods,basket={},{ }
  for _,entry in ipairs(c.goods) do table.insert(goods,{item=publicItem(entry.item),price=entry.price}) end
  for _,selection in ipairs(c.basket) do
   if c.mode=="Buyer" then
    local owned=Rules.find(s.profile,selection.id)
    if owned then local unit=publicItem(owned);unit.gridX=selection.gridX;unit.gridY=selection.gridY;unit.rotation=selection.rotation;table.insert(basket,unit) end
   else
   for _,entry in ipairs(c.goods) do
    if entry.item.id==selection.id then
     local item=publicItem(entry.item);item.gridX=selection.gridX;item.gridY=selection.gridY;item.rotation=selection.rotation;table.insert(basket,item);break
    end
   end
   end
  end
  local quote: any=nil
  if c.quote then
   local q=c.quote;local lines={}
   for _,line in ipairs(q.lines) do table.insert(lines,{id=line.id,kind=line.kind,name=line.name,price=line.price,basePrice=line.basePrice}) end
   local loose=0
   for _,item in ipairs(s.profile.inventory) do loose+=Items.Definitions[item.kind].denomination or 0 end
   quote={id=q.id,mode=q.mode,lines=lines,subtotal=q.subtotal,discount=q.discount,total=q.total,count=q.count,affordable=q.mode=="Sale" or s.profile.cash+loose>=q.total}
  end
  local bulkOriginal,bulkPrice=0,0
  if c.bulkPercent then for _,entry in ipairs(c.goods) do bulkOriginal+=entry.price;bulkPrice+=math.max(1,math.floor(entry.price*(100-c.bulkPercent)/100)) end end
  customer={id=c.id,name=c.name,personality=c.personality,faction=c.faction,kind=c.kind,itemId=c.itemId,requestTag=c.requestTag,
   payment=c.payment or {},paymentTotal=c.paymentTotal or 0,
   bulkPercent=c.bulkPercent,bulkOriginal=bulkOriginal,bulkPrice=bulkPrice,
   mode=c.mode,goods=goods,basket=basket,basketRevision=c.basketRevision,quote=quote,
   dialogue=c.dialogue,offer=c.offer,patience=c.patience,state=c.state,color=c.color,deadline=c.deadline}
 end
 local p=s.profile
 local cols,rows=Grid.size(p)
 state:FireClient(player,{cash=p.cash,day=p.day,inventory=inventory,customer=customer,
  capacity=Rules.capacity(p),gridColumns=cols,gridRows=rows,gridUsed=Grid.used(p),gridRevision=p.gridRevision,moveAck=moveAck,moveOk=moveOk,bill=Rules.bill(p),rent=Config.Rent+p.upgrade*5,operating=Config.OperatingCost,
  reputation=p.reputation,upgrade=p.upgrade,legacyRows=p.legacyRows,revenue=p.revenue,costs=p.costs,profit=p.tradeProfit,
  walletTier=p.walletTier or 0,walletSlots=p.walletSlots or {},walletStacks=Wallet.stacks(p.cash,p.walletTier or 0),
  visits=p.visits,maxVisits=Config.DailyVisitors(p.day),shopOpen=s.shopOpen,aidDay=p.aidDay,origin=s.origin,stageName=s.stage.Name,
  saveStatus=s.saveStatus,message=message,receipts=p.receipts,pendingArrival=s.pendingArrival,working=s.working})
end
local schedule: (Player)->()
local function leave(player: Player,message: string,line: string?,callNext: boolean?)
 local s=sessions[player]
 if not s or s.closed or not s.customer then return end
 local c=s.customer; c.dialogue=line or "See you another time.";c.state="Leave";c.basket={};c.basketRevision+=1;c.quote=nil; push(player,message)
 task.delay(Config.WalkSeconds,function()
  if sessions[player]~=s or s.closed or s.customer~=c then return end
  s.customer=nil; push(player); if callNext then schedule(player) end
 end)
end
schedule=function(player: Player)
 local s=sessions[player]
 if not s or s.closed or not s.shopOpen or s.profile.visits>=Config.DailyVisitors(s.profile.day) or s.working or s.customer or s.pendingArrival
  then return end
 s.pendingArrival=true; local epoch=s.epoch; push(player)
 task.delay(Config.ArrivalSeconds,function()
  if sessions[player]~=s or s.closed or s.epoch~=epoch then return end
  s.pendingArrival=false
  if s.customer then push(player); return end
  local c=Customers.create(s.profile,Rules,rng)
  if c.mode=="Seller" and rng:NextNumber()<Tags.BulkSellerChance then
   c.bulkPercent=rng:NextInteger(Tags.BulkDiscountMin,Tags.BulkDiscountMax)
   c.dialogue="I'll sell you the whole batch for "..c.bulkPercent.."% off."
  end
  local display={inventory={},upgrade=0,legacyRows=0}
  local repeats: {[string]: number}={}
  local supplyCount=if c.mode=="Seller" then rng:NextInteger(4,10) else 0
  for _=1,supplyCount do
   local total=0
   for _,kind in ipairs(Items.Order) do if (repeats[kind] or 0)<9 then total+=Tags.RarityWeights[Items.Definitions[kind].rarity] end end
   local roll=rng:NextInteger(1,total);local kind=Items.Order[1]
   for _,candidate in ipairs(Items.Order) do
    if (repeats[candidate] or 0)<9 then
     roll-=Tags.RarityWeights[Items.Definitions[candidate].rarity]
     if roll<=0 then kind=candidate;break end
    end
   end
   repeats[kind]=(repeats[kind] or 0)+1
   local entry=makeOffer(kind,s.profile);local x,y,rotation=TrayGrid.firstFit(display,kind)
   if x==nil then break end
   entry.item.gridX=x;entry.item.gridY=y;entry.item.rotation=rotation
   table.insert(display.inventory,entry.item);table.insert(c.goods,entry)
  end
  s.customer=c; s.profile.visits+=1
  push(player,"A customer is approaching the counter.")
  task.delay(Config.WalkSeconds,function()
   if sessions[player]~=s or s.closed or s.customer~=c or c.state~="WalkToCounter" then return end
   c.state="Interact";push(player)
  end)
 end)
end
local function matchingCustomer(s: any,request: any): any
 local c=s.customer
 if c and c.id==request.customerId and c.state=="Interact" then return c end
 return nil
end
action.OnServerEvent:Connect(function(player: Player,request: any)
 local s=sessions[player]
 if not s or s.closed or type(request)~="table" or type(request.action)~="string" or #request.action>20 then return end
 local now=os.clock()
 s.tokens=math.min(Config.RequestBurst,s.tokens+(now-s.lastRequest)*Config.RequestRate); s.lastRequest=now
 if s.tokens<1 then return end
 s.tokens-=1
 if not Persistence.safe(player.UserId) then
  s.closed=true; player:Kick("Your save session expired. Rejoin to safely reopen your shop."); return
 end
 local name=request.action
 if name=="Sync" then push(player); return end
 if name=="MoveMoney" then
  local tier=s.profile.walletTier or 0;local count=Wallet.Sizes[tier+1][1]*Wallet.Sizes[tier+1][2]
  local denomination=request.denomination;local slot=request.slot
  local valid=false
  for i=1,count do if Wallet.Denominations[i]==denomination then valid=true end end
  if not valid or not Rules.integer(slot,1,count) then push(player,"Invalid wallet position.");return end
  local positions=s.profile.walletSlots or {};s.profile.walletSlots=positions
  local current=positions[tostring(denomination)]
  for i=1,count do
   local other=Wallet.Denominations[i]
   if other~=denomination and (positions[tostring(other)] or i)==slot then positions[tostring(other)]=current or (table.find(Wallet.Denominations,denomination) or 1);break end
  end
  positions[tostring(denomination)]=slot;push(player);return
 end
 if name=="WithdrawMoney" then
  local denomination=request.denomination;local valid=false
  for _,stack in ipairs(Wallet.stacks(s.profile.cash,s.profile.walletTier or 0)) do if stack.denomination==denomination and stack.count>0 then valid=true end end
  if not valid then push(player,"No note of that denomination in your wallet.");return end
  local kind="cash"..denomination
  local ok,message=Grid.check(s.profile,kind,request.x,request.y,0)
  if not ok then push(player,message);return end
  s.profile.cash-=denomination
  table.insert(s.profile.inventory,{id=Http:GenerateGUID(false),kind=kind,paid=denomination,condition=100,authentic=true,restricted=false,inspected=false,qualityTag=Tags.DefaultQuality,gridX=request.x,gridY=request.y,rotation=0})
  s.profile.gridRevision+=1;push(player,"Moved "..denomination.." E into stock.");return
 end
 if name=="DepositMoney" then
  local item,index=Rules.find(s.profile,request.id)
  local denomination=item and Items.Definitions[item.kind].denomination
  if not denomination or not index then push(player,"That is not a loose note.");return end
  table.remove(s.profile.inventory,index);s.profile.cash+=denomination;s.profile.gridRevision+=1
  push(player,"Deposited "..denomination.." E into your wallet.");return
 end
 if name=="StagePayment" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"No active trade.");return end
  local ok,message=Trade.stagePayment(s.profile,c,request.denomination,request.id)
  push(player,message);return
 end
 if name=="ToggleShop" then
  if s.shopOpen then
   if s.customer then push(player,"Wait until the counter is clear before closing.");return end
   s.shopOpen=false;s.epoch+=1;s.pendingArrival=false;push(player,"Shop closed.")
  else s.shopOpen=true;push(player,"Shop open.");schedule(player) end
  return
 end
 if name=="Sleep" then
  if s.shopOpen or s.customer or s.pendingArrival then push(player,"Close the shop before sleeping.");return end
  local ok,message=Rules.endDay(s.profile)
  if ok then s.epoch+=1;s.pendingArrival=false end
  push(player,message);return
 end
 if name=="NextCustomer" then
  if not s.shopOpen or s.profile.visits>=Config.DailyVisitors(s.profile.day) then push(player,"Close the shop when the day's customers are done.");return end
  if s.working then push(player,"Freight shift active.");return end
  if s.customer then
   if s.customer.state~="Leave" then leave(player,"",nil,true) end
  else schedule(player) end
  return
 end
 if name=="PlaceItem" then
  if not Rules.integer(request.moveId,1,1000000000) then push(player,"Invalid move request."); return end
  local ok,message=Rules.move(s.profile,request.id,request.x,request.y,request.rotation,request.revision)
  if ok and s.customer then s.customer.quote=nil end
  push(player,message,request.moveId,ok); return
 end
 if name=="SetItemTag" then
  local ok,message=Rules.setItemTag(s.profile,request.id,request.qualityTag)
  if ok and s.customer then
   s.customer.quote=nil
   if s.customer.itemId==request.id then
    local item=Rules.find(s.profile,request.id)
    local value=Rules.value(item)
    s.customer.offer=math.max(1,math.floor(value*0.86))
    s.customer.budget=if s.customer.mode=="Buyer" then Rules.categoryBudget(s.customer.requestTag) else math.floor(value*1.35+math.max(0,s.profile.reputation)*2)
   end
  end
  push(player,message);return
 end
 if s.working then push(player,"Freight shift active."); return end
 if name=="DismissCustomer" then
  local c=matchingCustomer(s,request)
  if c then leave(player,"Customer dismissed.") else push(player,"No customer to dismiss.") end
  return
 end
 if name=="StageOffer" or name=="UnstageOffer" or name=="StageStock" or name=="UnstageStock" then
  if not Rules.integer(request.moveId,1,1000000000) then push(player,"Invalid drag request.");return end
  local c=matchingCustomer(s,request)
  if not c then push(player,"That visitor is no longer trading.",request.moveId,false);return end
  local ok,message
  if name=="StageOffer" then ok,message=Trade.stage(c,request.id,request.x,request.y,request.rotation,request.revision,s.profile,request.stockX,request.stockY,request.stockRotation)
  elseif name=="UnstageOffer" then ok,message=Trade.unstage(c,request.id,request.revision)
  elseif name=="StageStock" then ok,message=Trade.stageStock(s.profile,c,request.id,request.x,request.y,request.rotation,request.revision)
  else ok,message=Trade.unstageStock(s.profile,c,request.id,request.x,request.y,request.rotation,request.revision) end
  if ok and #c.basket>0 then ok,message=if c.mode=="Buyer" then Trade.reviewSale(s.profile,c,Http:GenerateGUID(false)) else Trade.review(s.profile,c,Http:GenerateGUID(false)) end
  push(player,message,request.moveId,ok);return
 elseif name=="ClearBasket" or name=="ReviewPurchase" or name=="ConfirmPurchase" or name=="BuyBulk" or name=="ReviewSale" or name=="ConfirmSale" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"That visitor is no longer trading.");return end
  local ok,message
  if name=="ClearBasket" then ok,message=Trade.clear(c)
  elseif name=="ReviewPurchase" then ok,message=Trade.review(s.profile,c,Http:GenerateGUID(false))
  elseif name=="BuyBulk" then ok,message=Trade.buyBulk(s.profile,c,Http:GenerateGUID(false));if ok then leave(player,message,"The whole haul is yours.");return end
  elseif name=="ReviewSale" then ok,message=Trade.reviewSale(s.profile,c,Http:GenerateGUID(false))
  elseif name=="ConfirmSale" then ok,message=Trade.confirmSale(s.profile,c,request.quoteId);if ok then leave(player,message,"I'll take these. Pleasure trading.");return end
  else ok,message=Trade.confirm(s.profile,c,request.quoteId);if ok then leave(player,message,"Deal. These goods are yours.");return end end
  push(player,message);return
 elseif name=="InspectGoods" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"No visitor at the window.");return end
  for _,entry in ipairs(c.goods) do
   if entry.item.id==request.id then entry.item.inspected=true;push(player,"Visitor's merchandise inspected.");return end
  end
  push(player,"This item is not offered by the current visitor.");return
 end
 local ok,message=false,"That action is unavailable."
 local id=request.id
 if name=="Inspect" and type(id)=="string" and #id<=80 then ok,message=Rules.inspect(s.profile,id)
 elseif name=="Accept" or name=="Counter" then
  local c=matchingCustomer(s,request)
  if c then
   local selectedId=if type(request.id)=="string" then request.id else c.itemId
   local item=Rules.find(s.profile,selectedId)
   if item and Rules.matches(c,item) then
    if item.id~=c.itemId then
     c.itemId=item.id;c.kind=item.kind
     local value=Rules.value(item);c.offer=math.max(1,math.floor(value*0.86));c.budget=if c.mode=="Buyer" then Rules.categoryBudget(c.requestTag) else math.floor(value*1.35+math.max(0,s.profile.reputation)*2)
    end
    local price=c.offer; local exhausted=false
    if name=="Counter" then ok,message,exhausted=Rules.negotiate(s.profile,c,item,request.price);c.dialogue=message; price=request.price
    else ok=true end
    if ok then
     ok,message=Rules.sell(s.profile,c,item.id,price)
     if ok then leave(player,message,"Thanks, that is what I was looking for."); return end
    elseif exhausted then leave(player,message); return end
   end
  end
 elseif name=="Refuse" then
  if matchingCustomer(s,request) then leave(player,"You declined the deal."); return end
 elseif name=="EndDay" then message="Use the sleeping bag after closing the shop."
 elseif name=="Work" then
  if s.customer or s.profile.cash>=Rules.bill(s.profile) then message="Freight work is available when bills are unaffordable and the counter is clear."
  else
   s.working=true; s.epoch+=1; s.pendingArrival=false
   push(player,"Freight shift active.")
   task.delay(10,function()
    if sessions[player]~=s or s.closed then return end
    s.working=false; s.profile.cash+=18; s.profile.revenue+=18; s.profile.tradeProfit+=18
    Rules.log(s.profile,"Freight shift income +18")
    push(player,"Freight shift complete. Earned 18 Eddies."); schedule(player)
   end)
   return
  end
 elseif name=="Aid" then ok,message=Rules.aid(s.profile)
 end
 push(player,message)
 if ok then schedule(player) end
end)
local function join(player: Player)
 if closing or sessions[player] or loading[player] then return end
 loading[player]=true
 local profile,status=Persistence.load(player.UserId,Rules)
 if not profile then loading[player]=nil;if player.Parent then player:Kick(status) end; return end
 local hasWallet=false
 for _,item in ipairs(profile.inventory) do if Items.Definitions[item.kind].walletTier~=nil then hasWallet=true;break end end
 if not hasWallet then
  local x,y,rotation=Grid.firstFit(profile,"wallet0")
  if x then table.insert(profile.inventory,{id=Http:GenerateGUID(false),kind="wallet0",paid=0,condition=100,authentic=true,restricted=false,inspected=false,qualityTag=Tags.DefaultQuality,gridX=x,gridY=y,rotation=rotation});profile.gridRevision+=1 end
 end
 loading[player]=nil
 if not player.Parent or closing then Persistence.save(player.UserId,profile,true); return end
 local slot=0
 while slots[slot] do slot+=1 end
 slots[slot]=true
 local origin=Vector3.new(slot*100,0,0)
 local stage=Scene.spawn(shopTemplate,workspace,origin,"Shop_"..player.UserId)
 sessions[player]={profile=profile,origin=origin,stage=stage,slot=slot,customer=nil,
  tokens=Config.RequestBurst,lastRequest=os.clock(),epoch=0,pendingArrival=false,
  saveStatus=status,closed=false,removing=false,working=false,shopOpen=true}
 push(player)
 schedule(player)
end
local function remove(player: Player)
 local s=sessions[player]
 if not s or s.removing then return end
 s.removing=true; s.closed=true; s.epoch+=1
 local ok,message=Persistence.save(player.UserId,s.profile,true)
 if not ok then warn("Latch Nine final save failed for "..player.UserId..": "..message) end
 s.stage:Destroy(); slots[s.slot]=nil; sessions[player]=nil
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(remove)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(join,player) end
task.spawn(function()
 while not closing do
  task.wait(Config.SaveInterval)
  for player,s in pairs(sessions) do
   if not s.closed then task.spawn(function()
    local ok,status=Persistence.save(player.UserId,s.profile,false)
    if sessions[player]~=s or s.closed then return end
    s.saveStatus=status; push(player)
    if not ok and not Persistence.safe(player.UserId) then
     s.closed=true; player:Kick("Save connection interrupted. Rejoin to protect your shop.")
    end
   end) end
  end
 end
end)
game:BindToClose(function()
 closing=true
 for player in pairs(sessions) do task.spawn(remove,player) end
 local deadline=os.clock()+25
 while (next(sessions) or next(loading)) and os.clock()<deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Persistence</string>
          <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Persistence = {}
local memoryOnly = RunService:IsStudio() and not Config.PersistenceInStudio
local store: any = nil
local token = game.JobId .. ":" .. HttpService:GenerateGUID(false)
local held: {[number]: boolean} = {}
local busy: {[number]: boolean} = {}
local touched: {[number]: number} = {}
local acquiring: {[number]: boolean} = {}
local leases: {[number]: string} = {}
local owners: {[number]: any} = {}

local function retry(callback: () -> any): (boolean, any)
	local result: any
	for attempt = 1, 3 do
		local ok, value = pcall(callback)
		if ok then return true, value end
		result = value
		if attempt < 3 then task.wait(2 ^ (attempt - 1) + math.random() * 0.3) end
	end
	return false, result
end

function Persistence.load(userId: number, rules: any): (any, string)
	if held[userId] or busy[userId] or acquiring[userId] then
		return nil, "Your previous shop is still saving. Wait a moment and rejoin."
	end
	if memoryOnly then
		local profile = rules.newProfile()
		held[userId] = true; touched[userId] = os.time(); owners[userId] = profile
		leases[userId] = HttpService:GenerateGUID(false)
		return profile, "SESSION ONLY / Studio"
	end
	acquiring[userId] = true
	local lease = token .. ":" .. HttpService:GenerateGUID(false)
	local reason = "Data service unavailable. Please rejoin."
	local ok, record = retry(function()
		if not store then store = DataStoreService:GetDataStore(Config.DataStoreName) end
		return store:UpdateAsync("player_" .. userId, function(old: any)
			local data = if old == nil then rules.newProfile() else (if type(old) == "table" then rules.migrate(old.data) else nil)
			if not data then
				reason = "Save data needs a version migration. Existing data was preserved."; return nil
			end
			if old and old.lock and old.lock.id ~= lease and os.time() - old.lock.at < Config.LockSeconds then
				reason = "Your previous shop is still saving. Wait a moment and rejoin."; return nil
			end
			return {data = data, lock = {id = lease, at = os.time()}}
		end)
	end)
	acquiring[userId] = nil
	if not ok or not record then return nil, reason end
	held[userId] = true; touched[userId] = os.time(); leases[userId] = lease; owners[userId] = record.data
	return record.data, "CLOUD SAVE / active"
end

function Persistence.safe(userId: number): boolean
	return held[userId] == true and (memoryOnly or os.time() - (touched[userId] or 0) < Config.LockSeconds - 30)
end

local function copy(value: any): any
	if type(value) ~= "table" then return value end
	local result: any = {}
	for key, child in pairs(value) do result[key] = copy(child) end
	return result
end

function Persistence.save(userId: number, profile: any, release: boolean): (boolean, string)
	-- Serialize all writes per key; snapshot only after any preceding write finishes.
	local lease = leases[userId]
	while busy[userId] do task.wait(0.05) end
	if not held[userId] or leases[userId] ~= lease or owners[userId] ~= profile then return false, "Session ownership lost" end
	busy[userId] = true
	if memoryOnly then
		if release then held[userId] = nil; touched[userId] = nil; leases[userId] = nil; owners[userId] = nil end
		busy[userId] = nil; return true, "SESSION ONLY / Studio"
	end
	local snapshot = copy(profile)
	local now = os.time()
	local ok, result = retry(function()
		return store:UpdateAsync("player_" .. userId, function(old: any)
			if type(old) ~= "table" or not old.lock or old.lock.id ~= lease then return nil end
			return {data = snapshot, lock = if release then nil else {id = lease, at = now}}
		end)
	end)
	busy[userId] = nil
	if ok and result then
		touched[userId] = now
		if release then held[userId] = nil; touched[userId] = nil; leases[userId] = nil; owners[userId] = nil end
		return true, "CLOUD SAVE / saved"
	end
	if ok then held[userId] = nil; return false, "Session ownership lost" end
	return false, "CLOUD SAVE / retrying"
end

return Persistence
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure, synchronous domain rules. Inject definitions for CLI tests and Studio.
return function(config: any, definitions: any, grid: any, tags: any)
	local Rules = {DefaultQuality=tags.DefaultQuality}
	local function integer(n: any, low: number, high: number): boolean
		return type(n) == "number" and n == n and n % 1 == 0 and n >= low and n <= high
	end
	Rules.integer = integer
	function Rules.newProfile(): any
		return {version = 5, legacyRows = 0, gridRevision = 0, cash = config.StartingCash, day = 1, walletTier = 0, inventory = {{id="starter-wallet",kind="wallet0",paid=0,condition=100,authentic=true,restricted=false,inspected=false,qualityTag=tags.DefaultQuality,gridX=0,gridY=0,rotation=0}}, reputation = 0,
			upgrade = 0, revenue = 0, costs = 0, tradeProfit = 0, visits = 0, aidDay = 0, receipts = {}}
	end
	local function validateFields(p: any, version: number): boolean
		if type(p) ~= "table" or p.version ~= version then return false end
		for _, key in ipairs({"cash", "day", "upgrade", "revenue", "costs", "visits", "aidDay"}) do
			if not integer(p[key], 0, 1000000000) then return false end
		end
		if p.day < 1 or p.upgrade > config.MaxUpgrade
			or not integer(p.reputation, -20, 20) or not integer(p.tradeProfit, -1000000000, 1000000000)
			or type(p.inventory) ~= "table" or #p.inventory > config.MaxInventory
			or type(p.receipts) ~= "table" or #p.receipts > 12 then return false end
		local seen: {[string]: boolean} = {}
		for _, receipt in ipairs(p.receipts) do
			if type(receipt) ~= "string" or #receipt > 300 then return false end
		end
		for key, item in pairs(p.inventory) do
			if not integer(key, 1, #p.inventory) or type(item) ~= "table" or type(item.id) ~= "string"
				or #item.id > 80 or seen[item.id] or not definitions[(item :: any).kind]
				or not integer((item :: any).condition, 30, 100) or not integer((item :: any).paid, 0, 1000000)
				or type((item :: any).authentic) ~= "boolean" or type((item :: any).restricted) ~= "boolean"
				or type((item :: any).inspected) ~= "boolean" then return false end
			seen[item.id] = true
		end
		return true
	end
	local function validGrid(p: any, version: number): boolean
		return validateFields(p, version) and integer(p.legacyRows, 0, config.MaxLegacyRows)
			and integer(p.gridRevision, 0, 1000000000) and (if version<5 then grid.validate(p,8,6+p.upgrade*2+p.legacyRows) else grid.validate(p))
	end
	function Rules.validate(p: any): boolean
		if not validGrid(p, 5) then return false end
		for _, item in ipairs(p.inventory) do
			if type((item :: any).qualityTag) ~= "string" or not tags.Qualities[(item :: any).qualityTag] then return false end
			if item.marketCondition~=nil and not tags.LegacyMarketConditions[item.marketCondition] then return false end
			if item.marketCondition=="bulk" and not integer(item.marketPercent,5,15) then return false end
			if item.criminality~=nil and not tags.Criminality[item.criminality] then return false end
			if item.rarity~=nil and not tags.RarityWeights[item.rarity] then return false end
		end
		return true
	end
	function Rules.setItemTag(p: any, id: any, quality: any): (boolean, string)
		if type(id) ~= "string" or #id > 80 or type(quality) ~= "string" or not tags.Qualities[quality] then return false, "Invalid item tag." end
		local item = Rules.find(p, id)
		if not item then return false, "Item not owned." end
		if item.qualityTag ~= quality then item.qualityTag = quality; p.gridRevision += 1 end
		return true, tags.Qualities[quality].name
	end
	local function clone(value: any): any
		if type(value) ~= "table" then return value end
		local out: any = {}; for key, child in pairs(value) do out[key] = clone(child) end; return out
	end
	function Rules.migrate(saved: any): any
		if type(saved) ~= "table" then return nil end
		if saved.version == 5 then return if Rules.validate(saved) then saved else nil end
		if saved.version ~= 1 and saved.version ~= 2 and saved.version ~= 3 and saved.version ~= 4 then return nil end
		if saved.version == 1 then
			if not validateFields(saved, 1) or #saved.inventory > 24 then return nil end
		elseif not validGrid(saved, saved.version) then return nil end
		if saved.version == 4 then
			for _, item in ipairs(saved.inventory) do if not tags.Qualities[(item :: any).qualityTag] then return nil end end
		end
		local p = clone(saved); local previous = p.inventory
		p.version = 5; p.inventory = {}; p.labels = nil; p.labelRevision = nil; p.legacyRows = 0; p.gridRevision = (p.gridRevision or 0) + 1
		for _, item in ipairs(previous) do
			local x, y, rotation = grid.firstFit(p, item.kind)
			while x == nil and p.legacyRows < config.MaxLegacyRows do p.legacyRows += 1; x, y, rotation = grid.firstFit(p, item.kind) end
			if x == nil then return nil end
			item.gridX = x; item.gridY = y; item.rotation = rotation; item.qualityTag = item.qualityTag or tags.DefaultQuality
			table.insert(p.inventory, item)
		end
		return if Rules.validate(p) then p else nil
	end
	function Rules.capacity(p: any): number local cols, rows = grid.size(p); return cols * rows end
	function Rules.move(p: any, id: any, x: any, y: any, rotation: any, revision: any): (boolean, string)
		if type(id) ~= "string" or #id > 80 then return false, "Invalid stock ID." end
		local item = Rules.find(p, id)
		if not item then return false, "That item is no longer in your storage." end
		if not integer(revision, 0, 1000000000) or revision ~= p.gridRevision then return false, "Storage changed." end
		local ok, reason = grid.check(p, item.kind, x, y, rotation, id)
		if not ok then return false, reason end
		if item.gridX ~= x or item.gridY ~= y or item.rotation ~= rotation then
			item.gridX = x; item.gridY = y; item.rotation = rotation; item.qualityTag = item.qualityTag or tags.DefaultQuality; p.gridRevision += 1
		end
		return true, "Stored. " .. definitions[item.kind].name .. " at column " .. (x+1) .. ", row " .. (y+1) .. "."
	end
	function Rules.bill(p: any): number return config.Rent + p.upgrade * 5 + config.OperatingCost end
	function Rules.value(item: any): number
		local value = definitions[item.kind].base * item.condition / 100
		if not item.authentic then value *= 0.58 end
		if item.restricted then value *= 1.15 end
		value *= tags.Qualities[item.qualityTag or tags.DefaultQuality].multiplier
		value *= tags.Criminality[item.criminality or "none"].multiplier
		return math.max(1, math.floor(value + 0.5))
	end
	function Rules.find(p: any, id: string): (any, number?)
		for index, item in ipairs(p.inventory) do if item.id == id then return item, index end end
		return nil, nil
	end
	function Rules.log(p: any, message: string)
		table.insert(p.receipts, 1, "D" .. p.day .. " / " .. message)
		if #p.receipts > 12 then table.remove(p.receipts) end
	end
	function Rules.purchase(p: any, item: any, price: number): (boolean, string)
		local x, y, rotation = grid.firstFit(p, item.kind)
		if x == nil then return false, "Insufficient storage space." end
		if p.cash < price then return false, "Not enough Eddies." end
		if Rules.find(p, item.id) then return false, "That item is already in storage." end
		p.cash -= price; p.costs += price; item.paid = price
		item.gridX = x; item.gridY = y; item.rotation = rotation; item.qualityTag = item.qualityTag or tags.DefaultQuality; p.gridRevision += 1
		table.insert(p.inventory, item)
		Rules.log(p, "Bought " .. definitions[item.kind].name .. " for " .. price)
		return true, "Purchased."
	end
	function Rules.inspect(p: any, id: string): (boolean, string)
		local item = Rules.find(p, id)
		if not item then return false, "Item no longer in storage." end
		item.inspected = true
		return true, "Inspected."
	end
	function Rules.category(item: any): string return definitions[item.kind].tagCategory end
	function Rules.categoryBudget(category: string): number
		local value=120
		for _,def in pairs(definitions) do if def.tagCategory==category then value=math.max(value,def.base*2) end end
		return value
	end
	function Rules.matches(customer: any, item: any): boolean
		local def=definitions[item.kind]
		if not def then return false end
		return if customer.requestTag then def.tagCategory==customer.requestTag else item.kind==customer.kind
	end
	function Rules.negotiate(p: any, customer: any, item: any, ask: any): (boolean, string, boolean)
		if not integer(ask, 1, 1000000) then return false, "Invalid sale price.", false end
		if customer.state ~= "Interact" or not Rules.matches(customer,item) then return false, "This customer wants a different item.", false end
		local value = Rules.value(item)
		local cap = math.min(customer.budget, math.floor(value * customer.tolerance + math.max(0, p.reputation) * 1.5))
		if ask <= cap then return true, "Deal accepted.", false end
		customer.patience -= 1
		customer.offer = math.min(cap, math.max(customer.offer, math.floor((customer.offer + cap) / 2)))
		if customer.patience <= 0 then return false, "Too expensive. I'm leaving.", true end
		return false, "Too high. My counteroffer is " .. customer.offer .. " Eddies.", false
	end
	function Rules.sell(p: any, customer: any, id: string, price: number): (boolean, string)
		local item, index = Rules.find(p, id)
		if not item or not index or customer.state ~= "Interact" or not Rules.matches(customer,item) then
			return false, "This sale is no longer available."
		end
		if not integer(price, 1, customer.budget) then return false, "Invalid sale price." end
		-- Fine and trust consequence are deterministic and disclosed by inspection.
		local fine = 0
		if item.restricted and customer.faction == "Transit Watch" then fine = math.min(p.cash + price, 25) end
		table.remove(p.inventory, index); p.gridRevision += 1
		p.cash += price - fine; p.revenue += price; p.costs += fine
		p.tradeProfit += price - item.paid - fine
		local honest = item.authentic and not item.restricted and item.condition >= 60
		p.reputation = math.clamp(p.reputation + (if honest then 1 else -1) - (if fine > 0 then 2 else 0), -20, 20)
		Rules.log(p, "Sold " .. definitions[item.kind].name .. " for " .. price .. (if fine > 0 then "; Watch fine " .. fine else ""))
		return true, "Sold for " .. price .. " Eddies." .. (if fine > 0 then " Restricted tech: 25-credit Watch fine." else "")
	end
	function Rules.endDay(p: any): (boolean, string)
		local bill = Rules.bill(p)
		if p.cash < bill then return false, "Need " .. bill .. " Eddies required for expenses." end
		p.cash -= bill; p.costs += bill; p.tradeProfit -= bill
		Rules.log(p, "Rent + operations paid: " .. bill)
		p.day += 1; p.visits = 0
		return true, "Expenses paid. A new trading day begins."
	end
	function Rules.aid(p: any): (boolean, string)
		if p.cash > Rules.bill(p) + 24 or p.aidDay == p.day then return false, "Emergency credit is available once per day when funds are low." end
		p.cash += 40; p.aidDay = p.day; p.reputation = math.max(-20, p.reputation - 2)
		Rules.log(p, "Emergency credit +40; trust -2")
		return true, "The dock union advances 40 Eddies. Trust falls by 2."
	end
	return Rules
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[--!strict
-- Staging is not ownership. Checkout commits an entire quoted basket atomically.
return function(config: any, definitions: any, rules: any, inventoryGrid: any, trayGrid: any, walletModule: any?)
 local Trade={}
 local wallet=walletModule or require("../shared/Wallet")
 local function clone(value: any): any
  if type(value)~="table" then return value end
  local out: any={};for k,v in pairs(value) do out[k]=clone(v) end;return out
 end
 local function offer(customer: any,id: string): any
  for _,entry in ipairs(customer.goods or {}) do if (entry :: any).item.id==id then return entry end end
  return nil
 end
 local function tray(customer: any): any return {inventory=customer.basket,upgrade=0,legacyRows=0} end
 local function ready(customer: any,revision: any): boolean
  return customer and customer.state=="Interact" and rules.integer(revision,0,1000000000) and revision==customer.basketRevision
 end
 function Trade.stage(customer: any,id: any,x: any,y: any,rotation: any,revision: any,profile: any?,stockX: any?,stockY: any?,stockRotation: any?): (boolean,string)
  if not ready(customer,revision) then return false,"Trade changed." end
  if type(id)~="string" or #id>80 then return false,"Invalid offered stock ID." end
  local entry=offer(customer,id)
  if not entry then return false,"This visitor is not offering that item." end
  local ok,reason=trayGrid.check(tray(customer),(entry :: any).item.kind,x,y,rotation,id)
  if not ok then return false,reason end
  if profile then
   local fits,why=inventoryGrid.check(profile,(entry :: any).item.kind,stockX,stockY,stockRotation)
   if not fits then return false,why end
  end
  local placed: any=nil
  for _,item in ipairs(customer.basket) do if item.id==id then placed=item;break end end
  if not placed then placed={id=id,kind=(entry :: any).item.kind};table.insert(customer.basket,placed) end
  placed.gridX=x;placed.gridY=y;placed.rotation=rotation
  if profile then placed.stockX=stockX;placed.stockY=stockY;placed.stockRotation=stockRotation end
  customer.basketRevision+=1;customer.quote=nil
  return true,"Selected."
 end
 function Trade.unstage(customer: any,id: any,revision: any): (boolean,string)
  if not ready(customer,revision) then return false,"Trade changed." end
  for index,item in ipairs(customer.basket) do
   if item.id==id then table.remove(customer.basket,index);customer.basketRevision+=1;customer.quote=nil;return true,"Item returned to the visitor's offer grid." end
  end
  return false,"That item is not selected."
 end
 function Trade.clear(customer: any): (boolean,string)
  if not customer or customer.state~="Interact" then return false,"No visitor is serving a trade." end
  customer.basket={};customer.payment={};customer.paymentTotal=0;customer.basketRevision+=1;customer.quote=nil
  return true,"Selection cleared."
 end
 function Trade.stagePayment(profile: any,customer: any,denomination: any,id: any): (boolean,string)
  if not customer or customer.mode~="Seller" or customer.state~="Interact" or #customer.basket==0 then return false,"Select goods first." end
  if not rules.integer(denomination,1,1000) or (id~=nil and (type(id)~="string" or #id>80)) then return false,"Invalid note." end
  local valid=false
  if id then
   local item=rules.find(profile,id)
   if item and definitions[item.kind].denomination==denomination then
    valid=true
    for _,entry in ipairs(customer.payment or {}) do if entry.id==id then valid=false end end
   end
  else
   for _,stack in ipairs(wallet.stacks(profile.cash,profile.walletTier or 0)) do
    if stack.denomination==denomination then
     local used=0
     for _,entry in ipairs(customer.payment or {}) do if not entry.id and entry.denomination==denomination then used+=1 end end
     valid=used<stack.count;break
    end
   end
  end
  if not valid then return false,"This note is not available." end
  customer.payment=customer.payment or {}
  table.insert(customer.payment,{id=id,denomination=denomination})
  customer.paymentTotal=(customer.paymentTotal or 0)+denomination
  return true,"Payment staged: "..customer.paymentTotal.." E."
 end
 function Trade.review(profile: any,customer: any,quoteId: string): (boolean,string)
  if not customer or customer.mode=="Buyer" or customer.state~="Interact" or #customer.basket==0 then return false,"No items selected." end
  local lines,plan={},{inventory=clone(profile.inventory),upgrade=profile.upgrade,legacyRows=profile.legacyRows}
  local subtotal,total=0,0
  for _,selection in ipairs(customer.basket) do
   local entry=offer(customer,(selection :: any).id)
   if not entry then customer.quote=nil;return false,"An offered item is no longer available." end
   local price=(entry :: any).price
   local item=clone((entry :: any).item);item.qualityTag=item.qualityTag or rules.DefaultQuality
   local x,y,rotation=inventoryGrid.firstFit(plan,item.kind)
   local desired: any=selection
   if desired.stockX~=nil then
    local fits=inventoryGrid.check(plan,item.kind,desired.stockX,desired.stockY,desired.stockRotation)
    if not fits then customer.quote=nil;return false,"The chosen stock space is occupied." end
    x,y,rotation=desired.stockX,desired.stockY,desired.stockRotation
   end
   if x==nil then customer.quote=nil;return false,"Insufficient storage space." end
   item.gridX=x;item.gridY=y;item.rotation=rotation;item.paid=price
   table.insert(plan.inventory,item)
   table.insert(lines,{id=item.id,kind=item.kind,name=definitions[item.kind].name,basePrice=(entry :: any).price,price=price,item=item})
   subtotal+=(entry :: any).price;total+=price
  end
  customer.quote={id=quoteId,basketRevision=customer.basketRevision,gridRevision=profile.gridRevision,
   lines=lines,subtotal=subtotal,discount=subtotal-total,total=total,count=#lines,plan=plan.inventory}
  return true,"Purchase review."
 end
 function Trade.reviewBulk(profile: any,customer: any,quoteId: string): (boolean,string)
  if not customer or customer.mode~="Seller" or customer.state~="Interact" or not customer.bulkPercent or #customer.goods==0 then return false,"No bulk offer." end
  local discount=customer.bulkPercent
  if not rules.integer(discount,5,15) then return false,"Invalid bulk offer." end
  local plan={inventory=clone(profile.inventory),upgrade=profile.upgrade,legacyRows=profile.legacyRows}
  local lines={};local subtotal,total=0,0
  for _,raw in ipairs(customer.goods) do
   local entry: any=raw
   local item=clone(entry.item);item.qualityTag=item.qualityTag or rules.DefaultQuality
   local x,y,rotation=inventoryGrid.firstFit(plan,item.kind)
   if x==nil then customer.quote=nil;return false,"Insufficient storage space for the entire batch." end
   local price=math.max(1,math.floor(entry.price*(100-discount)/100))
   item.gridX=x;item.gridY=y;item.rotation=rotation;item.paid=price
   table.insert(plan.inventory,item)
   table.insert(lines,{id=item.id,kind=item.kind,name=definitions[item.kind].name,basePrice=entry.price,price=price,item=item})
   subtotal+=entry.price;total+=price
  end
  customer.quote={id=quoteId,mode="Bulk",basketRevision=customer.basketRevision,gridRevision=profile.gridRevision,
   lines=lines,subtotal=subtotal,discount=subtotal-total,total=total,count=#lines,plan=plan.inventory}
  return true,"Whole batch review."
 end
 function Trade.buyBulk(profile: any,customer: any,quoteId: string): (boolean,string)
  local ok,message=Trade.reviewBulk(profile,customer,quoteId)
  if not ok then return false,message end
  local bought,reason=Trade.confirm(profile,customer,quoteId)
  if not bought then customer.quote=nil end
  return bought,reason
 end
 function Trade.confirm(profile: any,customer: any,quoteId: any): (boolean,string)
  if not customer or customer.mode=="Buyer" or customer.state~="Interact" then return false,"The visitor has left." end
  local q=customer.quote
  if not q or type(quoteId)~="string" or quoteId~=q.id then return false,"That purchase review has expired." end
  if q.basketRevision~=customer.basketRevision or q.gridRevision~=profile.gridRevision then
   customer.quote=nil;return false,"Trade changed."
  end
  local walletCash=profile.cash;local looseIds: {[string]: boolean}={};local paid=0
  local reserved: {[number]: number}={}
  for _,payment in ipairs(customer.payment or {}) do
   local denomination=payment.denomination
   if payment.id then
    local money=rules.find(profile,payment.id)
    if not money or definitions[money.kind].denomination~=denomination or looseIds[payment.id] then return false,"Payment changed." end
    looseIds[payment.id]=true
   else reserved[denomination]=(reserved[denomination] or 0)+1 end
   paid+=denomination
  end
  for _,stack in ipairs(wallet.stacks(walletCash,profile.walletTier or 0)) do
   if (reserved[stack.denomination] or 0)>stack.count then return false,"Wallet payment changed." end
  end
  local walletUsed=0
  for denomination,count in pairs(reserved) do walletUsed+=denomination*count end
  if paid<q.total then
   local needed=q.total-paid
   local fromWallet=math.min(needed,walletCash-walletUsed)
   walletUsed+=fromWallet;paid+=fromWallet
   if paid<q.total then
    for _,item in ipairs(profile.inventory) do
     local amount=definitions[item.kind].denomination
     if amount and not looseIds[item.id] then looseIds[item.id]=true;paid+=amount;if paid>=q.total then break end end
    end
   end
  end
  if paid<q.total then return false,"Not enough Eddies for this purchase." end
  -- Preserve live metadata (for example inspections performed after the quote).
  local committed={}
  for _,item in ipairs(profile.inventory) do if not looseIds[item.id] then table.insert(committed,item) end end
  local bought: {[string]: boolean}={}
  local newWalletTier=profile.walletTier or 0
  for _,line in ipairs(q.lines) do
   local entry=offer(customer,(line :: any).id)
   if not entry or rules.find(profile,(line :: any).id) then customer.quote=nil;return false,"An item is already owned or no longer offered." end
   local item=clone((entry :: any).item);item.qualityTag=item.qualityTag or rules.DefaultQuality;item.gridX=(line :: any).item.gridX;item.gridY=(line :: any).item.gridY;item.rotation=(line :: any).item.rotation;item.paid=(line :: any).price
   local tier=definitions[item.kind].walletTier
   if tier and tier>newWalletTier then
    for index=#committed,1,-1 do if definitions[committed[index].kind].walletTier~=nil then table.remove(committed,index) end end
    newWalletTier=tier
   end
   table.insert(committed,item);bought[(line :: any).id]=true
  end
  local plan={inventory=committed,upgrade=profile.upgrade,legacyRows=profile.legacyRows}
  if not inventoryGrid.validate(plan) then customer.quote=nil;return false,"The purchase layout is no longer valid." end
  local change=paid-q.total
  profile.cash=walletCash-walletUsed+change;profile.costs+=q.total;profile.inventory=committed;profile.walletTier=newWalletTier;profile.gridRevision+=1
  local remaining={}
  for _,entry in ipairs(customer.goods) do if not bought[(entry :: any).item.id] then table.insert(remaining,entry) end end
  customer.goods=remaining;customer.quote=nil;customer.basket={};customer.payment={};customer.paymentTotal=0;customer.basketRevision+=1
  rules.log(profile,"Bought "..q.count.." item(s) from "..customer.name.." for "..q.total)
  return true,"Bought "..q.count.." item(s) for "..q.total.." Eddies."..(if change>0 then " Customer returned "..change.." E in change." else "")
 end
 -- A buyer uses the same middle tray to hold stock from the shop.
 function Trade.stageStock(profile: any,customer: any,id: any,x: any,y: any,rotation: any,revision: any): (boolean,string)
  if not ready(customer,revision) or customer.mode~="Buyer" then return false,"Trade changed." end
  if type(id)~="string" or #id>80 then return false,"Invalid stock ID." end
  local item=rules.find(profile,id)
  if not item or not rules.matches(customer,item) then return false,"The buyer does not want that stock." end
  local ok,reason=trayGrid.check(tray(customer),item.kind,x,y,rotation,id)
  if not ok then return false,reason end
  local selected: any=nil
  for _,entry in ipairs(customer.basket) do if (entry :: any).id==id then selected=entry;break end end
  if not selected then selected={id=id,kind=item.kind};table.insert(customer.basket,selected) end
  selected.gridX=x;selected.gridY=y;selected.rotation=rotation
  customer.basketRevision+=1;customer.quote=nil
  return true,"Stock offered to buyer."
 end
 function Trade.unstageStock(profile: any,customer: any,id: any,x: any,y: any,rotation: any,revision: any): (boolean,string)
  if customer.mode~="Buyer" or not ready(customer,revision) then return false,"Trade changed." end
  local item=rules.find(profile,id)
  if not item then return false,"Stock changed." end
  local staged=false
  for _,entry in ipairs(customer.basket) do if (entry :: any).id==id then staged=true;break end end
  if not staged then return false,"Item is not staged." end
  local ok,reason=inventoryGrid.check(profile,item.kind,x,y,rotation,id)
  if not ok then return false,reason end
  local moved,message=rules.move(profile,id,x,y,rotation,profile.gridRevision)
  if not moved then return false,message end
  return Trade.unstage(customer,id,revision)
 end
 function Trade.reviewSale(profile: any,customer: any,quoteId: string): (boolean,string)
  if customer.mode~="Buyer" or customer.state~="Interact" or #customer.basket==0 then return false,"No stock selected." end
  local lines={};local total=0;local seen={}
  for _,selection in ipairs(customer.basket) do
   local item=rules.find(profile,(selection :: any).id)
   if seen[(selection :: any).id] or not item or not rules.matches(customer,item) then customer.quote=nil;return false,"Stock changed." end
   seen[(selection :: any).id]=true
   local price=if customer.itemId==item.id then customer.offer else math.max(1,math.floor(rules.value(item)*0.86))
   total+=price;table.insert(lines,{id=item.id,kind=item.kind,name=definitions[item.kind].name,price=price})
  end
  if total>customer.budget then customer.quote=nil;return false,"Buyer cannot afford this selection." end
  customer.quote={id=quoteId,mode="Sale",basketRevision=customer.basketRevision,gridRevision=profile.gridRevision,lines=lines,subtotal=total,total=total,count=#lines}
  return true,"Sale review."
 end
 function Trade.confirmSale(profile: any,customer: any,quoteId: any): (boolean,string)
  local q=customer and customer.quote
  if not customer or customer.mode~="Buyer" or customer.state~="Interact" or not q or q.mode~="Sale" or type(quoteId)~="string" or quoteId~=q.id then return false,"That sale review has expired." end
  if q.basketRevision~=customer.basketRevision or q.gridRevision~=profile.gridRevision then customer.quote=nil;return false,"Trade changed." end
  local working=clone(profile);local committed=clone(customer);local total=0
  for _,line in ipairs(q.lines) do
   local item=rules.find(working,(line :: any).id)
   if not item or not rules.matches(customer,item) then customer.quote=nil;return false,"Stock changed." end
   local expected=if customer.itemId==item.id then customer.offer else math.max(1,math.floor(rules.value(item)*0.86))
   if expected~=(line :: any).price then customer.quote=nil;return false,"Prices changed." end
   local ok=rules.sell(working,committed,item.id,(line :: any).price)
   if not ok then customer.quote=nil;return false,"Sale failed." end
   total+=(line :: any).price
  end
  if total~=q.total or total>customer.budget then customer.quote=nil;return false,"Buyer cannot afford this selection." end
  for _,key in ipairs({"cash","inventory","revenue","costs","tradeProfit","reputation","receipts","gridRevision"}) do profile[key]=working[key] end
  customer.quote=nil;customer.basket={};customer.basketRevision+=1
  return true,"Sold "..q.count.." item(s) for "..total.." Eddies."
 end
 return Trade
end
]]></string>
