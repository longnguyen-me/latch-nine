      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Scene</string>
          <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Scene = {}
local C = Color3.fromRGB

local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, neon: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.Position = position; p.Color = color
	p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false; p.CastShadow = false
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(parent: Instance, text: string, size: Vector3, position: Vector3, color: Color3)
	local board = part(parent, "Sign", size, position, C(15, 24, 32))
	local gui = Instance.new("SurfaceGui"); gui.Face = Enum.NormalId.Back
	gui.CanvasSize = Vector2.new(600, 120); gui.LightInfluence = 0; gui.Parent = board
	local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1; label.Text = text; label.Font = Enum.Font.Code
	label.TextScaled = true; label.TextColor3 = color; label.Parent = gui
	local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12); pad.Parent = label
end

function Scene.character(parent: Instance, position: Vector3, color: Color3): Model
	local model = Instance.new("Model"); model.Name = "PixelMerchant"
	local root = part(model, "Root", Vector3.new(0.1, 0.1, 0.1), position, color); root.Transparency = 1
	model.PrimaryPart = root
	local function block(name: string, x: number, y: number, w: number, h: number, c: Color3, z: number?)
		part(model, name, Vector3.new(w, h, 0.4), position + Vector3.new(x, y, z or 0), c)
	end
	block("BootL", -0.45, 0.22, 0.7, 0.45, C(21, 27, 35)); block("BootR", 0.45, 0.22, 0.7, 0.45, C(21, 27, 35))
	block("LegL", -0.4, 0.9, 0.55, 1.1, C(43, 57, 69)); block("LegR", 0.4, 0.9, 0.55, 1.1, C(43, 57, 69))
	block("Coat", 0, 2, 1.65, 1.5, color); block("Shirt", 0, 2.1, 0.35, 1.1, C(32, 42, 49), 0.23)
	block("ArmL", -1.02, 1.9, 0.42, 1.25, color); block("ArmR", 1.02, 1.9, 0.42, 1.25, color)
	block("HandL", -1.02, 1.16, 0.42, 0.36, C(203, 160, 128)); block("HandR", 1.02, 1.16, 0.42, 0.36, C(203, 160, 128))
	block("Head", 0, 3.35, 1.35, 1.2, C(203, 160, 128)); block("Hair", 0, 3.95, 1.5, 0.38, C(27, 32, 43))
	block("EyeL", -0.32, 3.4, 0.18, 0.18, C(20, 27, 33), 0.24); block("EyeR", 0.32, 3.4, 0.18, 0.18, C(20, 27, 33), 0.24)
	block("Badge", 0.48, 2.25, 0.25, 0.32, C(236, 192, 108), 0.24)
	model.Parent = parent
	return model
end

function Scene.move(model: Model, destination: Vector3, seconds: number): () -> ()
	local cf = Instance.new("CFrameValue"); cf.Value = model:GetPivot()
	local connection = cf.Changed:Connect(function(value: CFrame) if model.Parent then model:PivotTo(value) end end)
	local tween = TweenService:Create(cf, TweenInfo.new(seconds, Enum.EasingStyle.Linear), {Value = CFrame.new(destination)})
	local finished = false
	local function clean()
		if finished then return end
		finished = true; connection:Disconnect(); tween:Cancel(); cf:Destroy()
	end
	tween.Completed:Once(function() clean() end)
	tween:Play()
	return clean
end

function Scene.build(parent: Instance, origin: Vector3, name: string): Model
 local m = Instance.new("Model"); m.Name = name
 local function p(n: string,x: number,y: number,z: number,sx: number,sy: number,sz: number,color: Color3,neon: boolean?)
  return part(m,n,Vector3.new(sx,sy,sz),origin+Vector3.new(x,y,z),color,neon)
 end
 -- The viewer stands inside the booth. The service opening looks out onto a corridor.
 p("Hall darkness",-2,10,-6,20,12,0.5,C(14,20,31))
 for i=1,7 do
  p("Hall rib",-11+i*2.5,10,-5.6,0.25,11,0.35,C(36,44,54))
  p("Hall light",-11+i*2.5,14.2,-5.2,1,0.1,0.2,C(83,133,133),true)
 end
 p("Left booth wall",-18,9,0,14,20,0.7,C(48,64,68))
 p("Right booth wall",16,9,0,18,20,0.7,C(48,64,68))
 p("Ceiling beam",0,17,0,50,4,0.7,C(45,41,52))
 p("Lower booth wall",-2,2,0,20,6,0.6,C(48,64,68))
 for _,x in ipairs({-11.5,7.5}) do
  p("Window upright",x,10,0.7,0.7,11,0.8,C(103,83,79))
  p("Window inner trim",x+(if x<0 then 0.42 else -0.42),10,1.05,0.12,10.7,0.15,C(191,151,97),true)
 end
 p("Window lintel",-2,15.5,0.7,20,0.65,0.8,C(103,83,79))
 p("Service sill",-2,4.5,2,20,0.5,5,C(109,113,100))
 p("Counter surface",0,2.8,5,48,0.8,8,C(91,108,108))
 p("Counter front",0,-0.3,8.5,48,5.6,0.8,C(40,47,58))
 for x=-22,22,4 do
  p("Worn counter edge",x,3.23,8.9,1.5,0.07,0.15,C(150,144,119))
 end
 -- Mounted interaction surfaces face the seller. Counter tray is tilted toward the viewer.
 local function board(name: string,x: number,y: number,z: number,w: number,h: number,tilt: number?)
  local b=p(name,x,y,z,w,h,0.35,C(26,34,44));b.CanQuery=true
  if tilt then b.Orientation=Vector3.new(tilt,0,0) end
  return b
 end
 board("InventoryBoard",0,-1.8,9.3,23,10)
 board("VisitorBoard",12,11.1,2,13,5.9)
 local controls=Instance.new("Model");controls.Name="InteractionControls";controls.Parent=m
 local shutter=p("ShopToggle",-20,8,8,3,1.4,0.4,C(68,128,121));shutter.CanQuery=true
 for _,entry in ipairs({{shutter,Enum.NormalId.Back,C(111,218,196)}}) do
  local face=Instance.new("SurfaceGui");face.Name="EditOutline";face.Face=entry[2];face.CanvasSize=Vector2.new(320,100);face.LightInfluence=0;face.Parent=entry[1]
  local border=Instance.new("Frame");border.Name="Border";border.Size=UDim2.fromScale(1,1);border.BackgroundTransparency=1
  border.BorderSizePixel=5;border.BorderColor3=entry[3];border.Parent=face
  local label=Instance.new("TextLabel");label.Name="ButtonTitle";label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
  label.Text="OPEN / CLOSE";label.TextScaled=true;label.Font=Enum.Font.GothamBold;label.TextColor3=entry[3];label.Parent=face
 end
 local function control(name: string,title: string,y: number,z: number,h: number,color: Color3)
  local base=board(name,-14,y,z,4.6,h);base.Parent=controls
  local face=Instance.new("SurfaceGui");face.Name="EditOutline";face.Face=Enum.NormalId.Back
  face.CanvasSize=Vector2.new(320,100);face.LightInfluence=0;face.Parent=base
  local border=Instance.new("Frame");border.Name="Border";border.Size=UDim2.fromScale(1,1)
  border.BackgroundTransparency=1;border.BorderSizePixel=5;border.BorderColor3=color;border.Parent=face
  local label=Instance.new("TextLabel");label.Name="ButtonTitle";label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
  label.Text=title;label.TextScaled=true;label.Font=Enum.Font.GothamBold;label.TextColor3=color;label.Parent=face
 end
 control("RegisterBox","REGISTER",4.9,7.4,2.8,C(241,194,116))
 control("NextCustomerButton","NEXT CUSTOMER",2.8,9.2,1.1,C(111,218,196))
 control("DismissCustomerButton","DISMISS",1.5,9.2,1.1,C(242,127,120))
 local function marker(name: string,x: number,y: number,z: number)
  local value=p(name,x,y,z,0.2,0.2,0.2,C(113,209,182));value.Transparency=1
 end
 marker("ViewTarget",0,4.5,0)
 local mount=p("CameraMount",0,4.5,70,1.5,1,0.3,C(111,218,196));mount.Transparency=0.25
 marker("VisitorStand",-2,5.2,-1.8)
 marker("VisitorEntry",-14,5.2,-1.8)
 marker("VisitorExit",14,5.2,-1.8)
 p("Status terminal",-17,15.5,0.8,8,2.8,0.6,C(35,42,49))
 p("Status glow",-17,15.5,1.15,7.3,2.1,0.12,C(72,169,146),true)
 local money=p("MoneyDisplay",-17,12.4,0.9,8,3.1,0.6,C(18,36,39))
 local display=Instance.new("SurfaceGui");display.Name="CashSurface";display.Face=Enum.NormalId.Back
 display.CanvasSize=Vector2.new(640,240);display.LightInfluence=0;display.Parent=money
 local balance=Instance.new("TextLabel");balance.Name="Balance";balance.Size=UDim2.fromScale(1,1)
 balance.BackgroundTransparency=1;balance.Text="--- EDDIES";balance.Font=Enum.Font.Code
 balance.TextScaled=true;balance.TextColor3=C(111,231,192);balance.Parent=display
 sign(m,"NIGHT MARKET",Vector3.new(6,1,0.3),origin+Vector3.new(-2,16.7,1.1),C(222,186,113))
 for i=1,4 do
  p("Cable vertical",-23+i*0.3,10,0.6,0.1,18,0.2,C(28+i*5,34,40))
 end
 p("Pipe vertical",21,10,0.7,0.5,17,0.6,C(89,100,99))
 p("Pipe elbow",18,17,0.7,6,0.5,0.6,C(89,100,99))
 p("Radio",-17,4,5,4,2,2,C(44,50,62))
 p("Radio screen",-17,4.2,6.1,2.8,0.65,0.1,C(102,183,154),true)
 p("Desk keypad",-9,3.5,6,3,0.45,2.4,C(43,55,64))
 for x=0,3 do for y=0,2 do
  p("Key",-10+x*0.6,3.8,5.2+y*0.55,0.32,0.1,0.32,C(137,177,164))
 end end
 p("Receipt machine",16,4.1,4.7,6,2.3,3,C(110,120,111))
 p("Receipt paper",16,6,4.5,3.7,2.8,0.2,C(216,196,143))
 for i=1,4 do p("Receipt line",16,5.3+i*0.4,4.64,2.8,0.08,0.04,C(129,118,89)) end
 p("Desk lamp base",11,3.4,4.5,2.5,0.3,2,C(45,50,57))
 p("Desk lamp stem",11,6,4.5,0.25,5,0.25,C(75,80,79))
 p("Desk lamp shade",10.5,8.4,4.5,3,0.6,2,C(57,71,73))
 p("Lamp strip",10.5,8.05,4.5,2.5,0.1,1.5,C(225,196,126),true)
 for i=1,3 do p("Stock"..i,-21+(i-1)*2,4,5,1.2,1.2,1.2,C(63,72,77)) end
 m.Parent=parent;return m
end

-- Clone the saved Studio shop. Only offset the clone; never rebuild or modify the template.
function Scene.spawn(template: Model?,parent: Instance,origin: Vector3,name: string): Model
 if not template then return Scene.build(parent,origin,name) end
 local stage=template:Clone();stage.Name=name
 for _,object in ipairs(stage:GetDescendants()) do
  if object:IsA("BasePart") then object.CFrame=object.CFrame+origin end
  if object:IsA("SurfaceGui") and table.find({"inventorySurface","offersSurface","registerSurface","nextSurface","dismissSurface","toggleSurface"},object.Name) then object.Enabled=false end
 end
 stage.Parent=parent;return stage
end

function Scene.cash(stage: Model,amount: number)
 local part=stage:FindFirstChild("MoneyDisplay",true)
 local surface=if part then part:FindFirstChild("CashSurface") else nil
 local label=if surface then surface:FindFirstChild("Balance") else nil
 if label and label:IsA("TextLabel") then
  local value=tostring(amount).." EDDIES"
  if label.Text~=value then label.Text=value end
 end
end

function Scene.stock(stage: Model, counts: {number}, colors: {{number}})
	for i, count in ipairs(counts) do
		local stock = stage:FindFirstChild("Stock" .. i,true) :: Part?
		if stock then stock.Color = if count > 0 then C(colors[i][1], colors[i][2], colors[i][3]) else C(63, 72, 77) end
	end
end
return Scene
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
export type Item = {id: string, kind: string, paid: number, condition: number, authentic: boolean, restricted: boolean, inspected: boolean, qualityTag: string, gridX: number, gridY: number, rotation: number}
export type Profile = {version: number, legacyRows: number, gridRevision: number, cash: number, day: number, inventory: {Item}, reputation: number, upgrade: number, revenue: number, costs: number, tradeProfit: number, visits: number, aidDay: number, receipts: {string}}
export type Customer = {id: string, name: string, personality: string, faction: string, kind: string?, requestTag: string?, dialogue: string?, mode: string, goods: {any}, basket: {any}, basketRevision: number, quote: any?, offer: number, budget: number, tolerance: number, patience: number, state: string, color: {number}, itemId: string?, deadline: number?}
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Wallet</string>
          <string name="Source"><![CDATA[--!strict
local Wallet={}
Wallet.Denominations={1,5,10,25,50,100,250,500,1000}
Wallet.Sizes={{2,3},{3,3},{3,4},{4,4}}
Wallet.Prices={0,150,350,700}
Wallet.Rarities={"Common","Uncommon","Rare","Legendary"}
function Wallet.stacks(cash: number,tier: number): {any}
 local capacity=math.min(#Wallet.Denominations,Wallet.Sizes[tier+1][1]*Wallet.Sizes[tier+1][2])
 local remaining=cash;local counts={}
 for i=capacity,1,-1 do
  local denomination=Wallet.Denominations[i]
  counts[i]=math.floor(remaining/denomination);remaining%=denomination
 end
 local result={}
 for i=1,capacity do table.insert(result,{denomination=Wallet.Denominations[i],count=counts[i]}) end
 return result
end
return Wallet
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="32">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="33">
      <Properties>
        <string name="Name">LatchNine</string>
      </Properties>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">CustomerService</string>
          <string name="Source"><![CDATA[--!strict
local HttpService = game:GetService("HttpService")
local Tags=require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").ItemTags)
local Customers = {}
local archetypes = {
	{name = "Mara Venn", personality = "Patient", faction = "Dock Union", tolerance = 1.1, patience = 4, color = {86, 181, 177}},
	{name = "Pell Rusk", personality = "Frugal", faction = "Lower Decks", tolerance = 0.96, patience = 3, color = {207, 156, 87}},
	{name = "Inspector Sable", personality = "Exacting", faction = "Transit Watch", tolerance = 1.04, patience = 2, color = {126, 145, 184}},
	{name = "Ivo Coil", personality = "Impulsive", faction = "Free Relay", tolerance = 1.22, patience = 2, color = {176, 113, 174}},
}
function Customers.create(p: any, rules: any, rng: Random): any
	local archetype = archetypes[rng:NextInteger(1, #archetypes)]
	local buyer=p.visits%2==1
	local requested=if buyer then Tags.BuyerCategories[rng:NextInteger(1,#Tags.BuyerCategories)] else nil
	local item=nil
	if requested then
	 for _,unit in ipairs(p.inventory) do if rules.category(unit)==requested then item=unit;break end end
	end
	local value=if item then rules.value(item) else 0
	local line=if requested then "I'm looking for "..Tags.Categories[requested].name:lower()..". Do you have anything?" else "I've got some unmarked goods. Looking to sell."

	return {id = HttpService:GenerateGUID(false), name = archetype.name, personality = archetype.personality,
		faction = archetype.faction, tolerance = archetype.tolerance, color = archetype.color,
		mode = if buyer then "Buyer" else "Seller", goods = {}, basket = {}, basketRevision = 0, quote = nil,
		dialogue=line,requestTag=requested, kind = if item then item.kind else nil, itemId = if item then item.id else nil,
		budget = if buyer then rules.categoryBudget(requested) else 0,
		offer = math.max(1, math.floor(value * 0.86)), patience = archetype.patience, state = "WalkToCounter"}
end
return Customers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">MachineService</string>
          <string name="Source"><![CDATA[--!strict
-- Machine contents live on the owned machine item, so saves are atomic with inventory.
return function(definitions: any, grid: any)
 local Machine={}
 local function validItem(item: any): boolean
  return type(item)=="table" and type(item.id)=="string" and #item.id<=80 and definitions[item.kind]~=nil
   and type(item.condition)=="number" and type(item.paid)=="number" and type(item.authentic)=="boolean"
   and type(item.restricted)=="boolean" and type(item.inspected)=="boolean"
 end
 local function state(machine: any): any
  if not machine.machine then machine.machine={input={},output={},press=nil,nextAt=nil} end
  return machine.machine
 end
 function Machine.validate(machine: any): boolean
  local def=definitions[machine.kind]
  if not def or not def.machine then return false end
  local m=machine.machine
  if m==nil then return true end
  if type(m)~="table" or type(m.input)~="table" or type(m.output)~="table"
   or #m.input>def.inputColumns*def.inputRows or #m.output>def.outputCapacity
   or (m.nextAt~=nil and (type(m.nextAt)~="number" or m.nextAt%1~=0 or m.nextAt<0 or m.nextAt>100000000000)) then return false end
  if m.press and (def.machine~="printer" or not validItem(m.press) or m.press.kind~="mintPress") then return false end
  local seen={}
  for _,item in ipairs(m.input) do
   if not validItem(item) or seen[item.id] or (def.machine=="printer" and not definitions[item.kind].paperQuality)
    or (def.machine=="laundry" and item.kind~="dirty100") then return false end
   seen[item.id]=true
  end
  for _,item in ipairs(m.output) do
   if not validItem(item) or seen[item.id] or (def.machine=="printer" and item.kind~="dirty100")
    or (def.machine=="laundry" and item.kind~="cash100") then return false end
   seen[item.id]=true
  end
  return not m.press or not seen[m.press.id]
 end
 local function find(profile: any,id: any): (any,number?)
  if type(id)~="string" or #id>80 then return nil end
  for i,item in ipairs(profile.inventory) do if item.id==id then return item,i end end
  return nil
 end
 function Machine.insert(profile: any,machineId: any,itemId: any,slot: any,x: any,y: any,now: number): (boolean,string)
  local machine=find(profile,machineId);local item,index=find(profile,itemId)
  if not machine or not item or not index or machine==item then return false,"Item is no longer in stock." end
  local def=definitions[machine.kind];if not def or not def.machine then return false,"Not a machine." end
  local m=state(machine)
  if slot=="press" then
   if def.machine~="printer" or item.kind~="mintPress" or m.press then return false,"Mint Press slot is unavailable." end
   m.press=item
  elseif slot=="input" then
   if (def.machine=="printer" and not definitions[item.kind].paperQuality) or (def.machine=="laundry" and item.kind~="dirty100") then return false,"Wrong input material." end
   if type(x)~="number" or type(y)~="number" or x%1~=0 or y%1~=0 or x<0 or y<0 or x>=def.inputColumns or y>=def.inputRows then return false,"Invalid input cell." end
   if #m.input>=def.inputColumns*def.inputRows then return false,"Input is full." end
   for _,entry in ipairs(m.input) do if entry.machineX==x and entry.machineY==y then return false,"Input cell occupied." end end
   item.machineX=x;item.machineY=y;m.input[#m.input+1]=item
  else return false,"Invalid machine slot." end
  table.remove(profile.inventory,index);profile.gridRevision+=1
  if not m.nextAt and #m.input>0 and (def.machine=="laundry" or m.press) and #m.output<def.outputCapacity then m.nextAt=now+def.seconds end
  return true,"Loaded machine."
 end
 function Machine.extract(profile: any,machineId: any,itemId: any,slot: any,x: any,y: any): (boolean,string)
  local machine=find(profile,machineId);if not machine or not definitions[machine.kind].machine then return false,"Machine missing." end
  local m=state(machine);local item: any=nil;local index: number?=nil;local source: any=nil
  if slot=="press" then if m.press and m.press.id==itemId then item=m.press end
  elseif slot=="input" or slot=="output" then
   source=m[slot]
   for i,entry in ipairs(source) do if entry.id==itemId then item=entry;index=i;break end end
  end
  if not item then return false,"Machine item missing." end
  local fits,reason=grid.check(profile,item.kind,x,y,0)
  if not fits then return false,reason end
  if source and index then table.remove(source,index) else m.press=nil end
  item.machineX=nil;item.machineY=nil;item.gridX=x;item.gridY=y;item.rotation=0
  table.insert(profile.inventory,item);profile.gridRevision+=1
  if #m.input==0 or (definitions[machine.kind].machine=="printer" and not m.press) then m.nextAt=nil end
  return true,"Returned item to stock."
 end
 function Machine.move(profile: any,machineId: any,itemId: any,slot: any,x: any,y: any): (boolean,string)
  local machine=find(profile,machineId)
  local def=machine and definitions[machine.kind]
  if not def or not def.machine or (slot~="input" and slot~="output") then return false,"Machine slot missing." end
  local m=state(machine)
  local columns=if slot=="input" then def.inputColumns else 1
  local rows=if slot=="input" then def.inputRows else def.outputCapacity
  if type(x)~="number" or type(y)~="number" or x%1~=0 or y%1~=0 or x<0 or y<0 or x>=columns or y>=rows then return false,"Invalid machine cell." end
  local source=m[slot];local item: any=nil;local sourceIndex: number?=nil
  for index,entry in ipairs(source) do if entry.id==itemId then item=entry;sourceIndex=index;break end end
  if not item then return false,"Machine item missing." end
  if slot=="output" then
   -- Outputs occupy the first #output cells; swapping keeps collection order and avoids holes.
   local target=y+1
   if target>#source then return false,"Output cell is empty." end
   source[sourceIndex],source[target]=source[target],source[sourceIndex]
  else
   for _,entry in ipairs(source) do if entry~=item and entry.machineX==x and entry.machineY==y then return false,"Input cell occupied." end end
   item.machineX=x;item.machineY=y
  end
  profile.gridRevision+=1
  return true,"Machine items rearranged."
 end
 function Machine.tick(profile: any,now: number,newId: ()->string,roll: (number,number)->number): boolean
  local changed=false
  for _,machine in ipairs(profile.inventory) do
   local def=definitions[machine.kind]
   if def and def.machine then
    local m=state(machine)
    local ready=#m.input>0 and #m.output<def.outputCapacity and (def.machine=="laundry" or m.press~=nil)
    if not ready then m.nextAt=nil
    else
     if not m.nextAt then m.nextAt=now+def.seconds;changed=true end
     while m.nextAt and m.nextAt<=now and #m.input>0 and #m.output<def.outputCapacity and (def.machine=="printer" or profile.cash>=10) do
      local source=table.remove(m.input,1)
      local quality=if def.machine=="printer" then definitions[source.kind].paperQuality else source.paperQuality or "low"
      if def.machine=="printer" or roll(1,100)<=({low=65,mid=80,high=95})[quality] then
       local kind=if def.machine=="printer" then "dirty100" else "cash100"
       local note={id=newId(),kind=kind,paid=0,condition=100,authentic=true,restricted=false,inspected=false,qualityTag="standard",paperQuality=quality,gridX=0,gridY=0,rotation=0}
       m.output[#m.output+1]=note
      end
      if def.machine=="laundry" then profile.cash-=10;profile.costs+=10;profile.tradeProfit-=10 end
      changed=true;m.nextAt+=def.seconds
     end
     if #m.input==0 or #m.output>=def.outputCapacity or (def.machine=="printer" and not m.press) then m.nextAt=nil end
    end
   end
  end
  return changed
 end
 return Machine
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="36">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")
local Shared = RS:WaitForChild("Shared")
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Scene = require(Shared.Scene)
local Tags = require(Shared.ItemTags)
local Wallet = require(Shared.Wallet)
local Grid = require(Shared.Grid)(Config, Items.Definitions)
local Machine = require(script.Parent.MachineService)(Items.Definitions,Grid)
local Suspicion = require(script.Parent.Suspicion)(Items.Definitions)
local Rules = require(script.Parent.Rules)(Config, Items.Definitions, Grid, Tags,Machine)
local trayConfig: any = table.clone(Config);trayConfig.GridColumns=Config.TradeColumns;trayConfig.GridBaseRows=Config.TradeRows;trayConfig.GridRowsPerUpgrade=0
local TrayGrid = require(Shared.Grid)(trayConfig, Items.Definitions)
local Trade = require(script.Parent.TradeService)(Config, Items.Definitions, Rules, Grid, TrayGrid, Wallet)
local Persistence = require(script.Parent.Persistence)
local Customers = require(script.Parent.CustomerService)
Players.CharacterAutoLoads = false
local shopTemplate = workspace:FindFirstChild("ShopTemplate") or workspace:FindFirstChild("StagePreview")
assert(shopTemplate,"Workspace.ShopTemplate is missing. Open the updated LatchNine place.")
-- Copy the Studio-authored physical GUI layouts before creating private player shops.
local shopSurfaces=Instance.new("Folder");shopSurfaces.Name="ShopSurfaces"
for _,name in ipairs({"inventorySurface","offersSurface","registerSurface","nextSurface","dismissSurface","toggleSurface"}) do
 local layout=shopTemplate:FindFirstChild(name,true)
 assert(layout and layout:IsA("SurfaceGui"),"ShopTemplate is missing editable GUI "..name)
 local copy=layout:Clone();copy.Adornee=nil;copy.Parent=shopSurfaces
end
shopSurfaces.Parent=RS
shopTemplate.Name="ShopTemplate";shopTemplate.Parent=game:GetService("ServerStorage")
local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = RS
local action = Instance.new("RemoteEvent"); action.Name = "Action"; action.Parent = remotes
local state = Instance.new("RemoteEvent"); state.Name = "State"; state.Parent = remotes
local sessions: {[Player]: any} = {}
local loading: {[Player]: boolean} = {}
local slots: {[number]: boolean} = {}
local closing = false
local rng = Random.new()
local function publicItem(item: any): any
 local out: any = {criminality=item.criminality or "none",id=item.id,kind=item.kind,inspected=item.inspected,paid=item.paid,gridX=item.gridX,gridY=item.gridY,rotation=item.rotation,machineX=item.machineX,machineY=item.machineY,qualityTag=item.qualityTag or Tags.DefaultQuality,categoryTag=Items.Definitions[item.kind].tagCategory,marketPrice=Rules.value(item)}
 if Items.Definitions[item.kind].machine then
  local m=item.machine or {input={},output={},press=nil}
  out.machine={input={},output={},press=if m.press then publicItem(m.press) else nil,nextAt=m.nextAt}
  for _,entry in ipairs(m.input) do table.insert(out.machine.input,publicItem(entry)) end
  for _,entry in ipairs(m.output) do table.insert(out.machine.output,publicItem(entry)) end
 end
 out.paperQuality=item.paperQuality
 if item.inspected then
  out.condition=item.condition; out.authentic=item.authentic
  out.restricted=item.restricted; out.value=Rules.value(item)
 end
 return out
end
local function makeOffer(kind: string,p: any): any
 local qualityRoll=rng:NextInteger(1,100)
 local item={id=Http:GenerateGUID(false),kind=kind,rarity=Items.Definitions[kind].rarity,
  criminality=if rng:NextNumber()<0.08 then "low" else "none",paid=0,qualityTag=Tags.QualityOrder[if qualityRoll<=20 then 1 elseif qualityRoll>80 then 3 else 2],condition=rng:NextInteger(65,100),
  authentic=rng:NextNumber()>0.17,restricted=false,inspected=false}
 local price=math.max(8,math.floor(Rules.value(item)*0.58))
 if p.reputation>=Config.ReputationDiscountAt then price=math.max(1,price-2) end
 return {item=item,price=price}
end
local function push(player: Player,message: string?, moveAck: number?, moveOk: boolean?)
 local s=sessions[player]
 if not s or s.closed then return end
 local inventory,counts,colors={},{},{}
 for _,item in ipairs(s.profile.inventory) do table.insert(inventory,publicItem(item)) end
 for _,kind in ipairs(Items.Order) do
  local count=0
  for _,item in ipairs(s.profile.inventory) do if item.kind==kind then count+=1 end end
  table.insert(counts,count); table.insert(colors,Items.Definitions[kind].color)
 end
 Scene.stock(s.stage,counts,colors)
 Scene.cash(s.stage,s.profile.cash)
 local customer: any=nil
 if s.customer then
  local c=s.customer
  local goods,basket={},{ }
  for _,entry in ipairs(c.goods) do table.insert(goods,{item=publicItem(entry.item),price=entry.price}) end
  for _,selection in ipairs(c.basket) do
   if c.mode=="Buyer" then
    local owned=Rules.find(s.profile,selection.id)
    if owned then local unit=publicItem(owned);unit.gridX=selection.gridX;unit.gridY=selection.gridY;unit.rotation=selection.rotation;table.insert(basket,unit) end
   else
   for _,entry in ipairs(c.goods) do
    if entry.item.id==selection.id then
     local item=publicItem(entry.item);item.gridX=selection.gridX;item.gridY=selection.gridY;item.rotation=selection.rotation
     item.stockX=selection.stockX;item.stockY=selection.stockY;item.stockRotation=selection.stockRotation
     table.insert(basket,item);break
    end
   end
   end
  end
  local quote: any=nil
  if c.quote then
   local q=c.quote;local lines={}
   for _,line in ipairs(q.lines) do table.insert(lines,{id=line.id,kind=line.kind,name=line.name,price=line.price,basePrice=line.basePrice}) end
   local loose=0
   for _,item in ipairs(s.profile.inventory) do loose+=Items.Definitions[item.kind].denomination or 0 end
   quote={id=q.id,mode=q.mode,lines=lines,subtotal=q.subtotal,discount=q.discount,total=q.total,count=q.count,affordable=q.mode=="Sale" or s.profile.cash+loose>=q.total}
  end
  local bulkOriginal,bulkPrice=0,0
  if c.bulkPercent then for _,entry in ipairs(c.goods) do bulkOriginal+=entry.price;bulkPrice+=math.max(1,math.floor(entry.price*(100-c.bulkPercent)/100)) end end
  customer={id=c.id,name=c.name,personality=c.personality,faction=c.faction,kind=c.kind,itemId=c.itemId,requestTag=c.requestTag,
   payment=c.payment or {},paymentTotal=c.paymentTotal or 0,
   bulkPercent=c.bulkPercent,bulkOriginal=bulkOriginal,bulkPrice=bulkPrice,
   mode=c.mode,goods=goods,basket=basket,basketRevision=c.basketRevision,quote=quote,
   dialogue=c.dialogue,offer=c.offer,patience=c.patience,state=c.state,color=c.color,deadline=c.deadline}
 end
 local p=s.profile
 local cols,rows=Grid.size(p)
 state:FireClient(player,{cash=p.cash,suspicion=p.suspicion or 0,inventory=inventory,customer=customer,
  capacity=Rules.capacity(p),gridColumns=cols,gridRows=rows,gridUsed=Grid.used(p),gridRevision=p.gridRevision,moveAck=moveAck,moveOk=moveOk,bill=Rules.bill(p),rent=Config.Rent+p.upgrade*5,operating=Config.OperatingCost,
  reputation=p.reputation,upgrade=p.upgrade,legacyRows=p.legacyRows,revenue=p.revenue,costs=p.costs,profit=p.tradeProfit,
  walletTier=p.walletTier or 0,walletSlots=p.walletSlots or {},walletStacks=Wallet.stacks(p.cash,p.walletTier or 0),
  shopOpen=s.shopOpen,origin=s.origin,stageName=s.stage.Name,
  saveStatus=s.saveStatus,message=message,receipts=p.receipts,pendingArrival=s.pendingArrival,working=s.working})
end
local schedule: (Player)->()
local function leave(player: Player,message: string,line: string?,callNext: boolean?)
 local s=sessions[player]
 if not s or s.closed or not s.customer then return end
 local c=s.customer; c.dialogue=line or "See you another time.";c.state="Leave";c.basket={};c.basketRevision+=1;c.quote=nil; push(player,message)
 task.delay(Config.WalkSeconds,function()
  if sessions[player]~=s or s.closed or s.customer~=c then return end
  s.customer=nil; push(player); if callNext then schedule(player) end
 end)
end
schedule=function(player: Player)
 local s=sessions[player]
 if not s or s.closed or not s.shopOpen or s.working or s.customer or s.pendingArrival
  then return end
 s.pendingArrival=true; local epoch=s.epoch; push(player)
 task.delay(Config.ArrivalSeconds*(if (s.profile.suspicion or 0)>=50 then 4/3 else 1),function()
  if sessions[player]~=s or s.closed or s.epoch~=epoch then return end
  s.pendingArrival=false
  if s.customer then push(player); return end
  local c=Customers.create(s.profile,Rules,rng)
  if c.mode=="Seller" and rng:NextNumber()<Tags.BulkSellerChance then
   c.bulkPercent=rng:NextInteger(Tags.BulkDiscountMin,Tags.BulkDiscountMax)
   c.dialogue="I'll sell you the whole batch for "..c.bulkPercent.."% off."
  end
  local display={inventory={},upgrade=0,legacyRows=0}
  local repeats: {[string]: number}={}
  local supplyCount=if c.mode=="Seller" then rng:NextInteger(4,10) else 0
  for _=1,supplyCount do
   local total=0
   for _,kind in ipairs(Items.Order) do if (repeats[kind] or 0)<9 then total+=Tags.RarityWeights[Items.Definitions[kind].rarity] end end
   local roll=rng:NextInteger(1,total);local kind=Items.Order[1]
   for _,candidate in ipairs(Items.Order) do
    if (repeats[candidate] or 0)<9 then
     roll-=Tags.RarityWeights[Items.Definitions[candidate].rarity]
     if roll<=0 then kind=candidate;break end
    end
   end
   repeats[kind]=(repeats[kind] or 0)+1
   local entry=makeOffer(kind,s.profile);local x,y,rotation=TrayGrid.firstFit(display,kind)
   if x==nil then break end
   entry.item.gridX=x;entry.item.gridY=y;entry.item.rotation=rotation
   table.insert(display.inventory,entry.item);table.insert(c.goods,entry)
  end
  s.customer=c; s.profile.visits+=1
  push(player,"A customer is approaching the counter.")
  task.delay(Config.WalkSeconds,function()
   if sessions[player]~=s or s.closed or s.customer~=c or c.state~="WalkToCounter" then return end
   c.state="Interact";push(player)
  end)
 end)
end
local function matchingCustomer(s: any,request: any): any
 local c=s.customer
 if c and c.id==request.customerId and c.state=="Interact" then return c end
 return nil
end
action.OnServerEvent:Connect(function(player: Player,request: any)
 local s=sessions[player]
 if not s or s.closed or type(request)~="table" or type(request.action)~="string" or #request.action>20 then return end
 local now=os.clock()
 s.tokens=math.min(Config.RequestBurst,s.tokens+(now-s.lastRequest)*Config.RequestRate); s.lastRequest=now
 if s.tokens<1 then return end
 s.tokens-=1
 if not Persistence.safe(player.UserId) then
  s.closed=true; player:Kick("Your save session expired. Rejoin to safely reopen your shop."); return
 end
 local name=request.action
 if name=="Sync" then push(player); return end
 if name=="MoveMoney" then
  local tier=s.profile.walletTier or 0;local count=Wallet.Sizes[tier+1][1]*Wallet.Sizes[tier+1][2]
  local denomination=request.denomination;local slot=request.slot
  local valid=false
  for i=1,count do if Wallet.Denominations[i]==denomination then valid=true end end
  if not valid or not Rules.integer(slot,1,count) then push(player,"Invalid wallet position.");return end
  local positions=s.profile.walletSlots or {};s.profile.walletSlots=positions
  local current=positions[tostring(denomination)]
  for i=1,count do
   local other=Wallet.Denominations[i]
   if other~=denomination and (positions[tostring(other)] or i)==slot then positions[tostring(other)]=current or (table.find(Wallet.Denominations,denomination) or 1);break end
  end
  positions[tostring(denomination)]=slot;push(player);return
 end
 if name=="WithdrawMoney" then
  local denomination=request.denomination;local valid=false
  for _,stack in ipairs(Wallet.stacks(s.profile.cash,s.profile.walletTier or 0)) do if stack.denomination==denomination and stack.count>0 then valid=true end end
  if not valid then push(player,"No note of that denomination in your wallet.");return end
  local kind="cash"..denomination
  local ok,message=Grid.check(s.profile,kind,request.x,request.y,0)
  if not ok then push(player,message);return end
  s.profile.cash-=denomination
  table.insert(s.profile.inventory,{id=Http:GenerateGUID(false),kind=kind,paid=denomination,condition=100,authentic=true,restricted=false,inspected=false,qualityTag=Tags.DefaultQuality,gridX=request.x,gridY=request.y,rotation=0})
  s.profile.gridRevision+=1;push(player,"Moved "..denomination.." E into stock.");return
 end
 if name=="DepositMoney" then
  local item,index=Rules.find(s.profile,request.id)
  local denomination=item and Items.Definitions[item.kind].denomination
  if not denomination or not index or Items.Definitions[item.kind].dirty then push(player,"Dirty notes must be laundered first.");return end
  table.remove(s.profile.inventory,index);s.profile.cash+=denomination;s.profile.gridRevision+=1
  push(player,"Deposited "..denomination.." E into your wallet.");return
 end
 if name=="StagePayment" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"No active trade.");return end
  local ok,message=Trade.stagePayment(s.profile,c,request.denomination,request.id)
  push(player,message);return
 end
 if name=="RotateOffer" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"No active offer.");return end
  local ok,message=Trade.rotateOffer(c,request.id,request.revision)
  push(player,message);return
 end
 if name=="MachineInsert" or name=="MachineExtract" or name=="MachineMove" then
  if not Rules.integer(request.moveId,1,1000000000) then push(player,"Invalid machine move.");return end
  Machine.tick(s.profile,os.time(),function() return Http:GenerateGUID(false) end,function(a: number,b: number) return rng:NextInteger(a,b) end)
  local ok,message
  if name=="MachineInsert" then ok,message=Machine.insert(s.profile,request.machineId,request.id,request.slot,request.x,request.y,os.time())
  elseif name=="MachineMove" then ok,message=Machine.move(s.profile,request.machineId,request.id,request.slot,request.x,request.y)
  else ok,message=Machine.extract(s.profile,request.machineId,request.id,request.slot,request.x,request.y) end
  push(player,message,request.moveId,ok);return
 end
 if name=="ToggleShop" then
  if s.shopOpen then
   s.shopOpen=false;s.epoch+=1;s.pendingArrival=false
   if s.customer and s.customer.state~="Leave" then leave(player,"Shop closed early.","The shop is closing. I'll return another time.")
   else push(player,"Shop closed.") end
  else s.shopOpen=true;push(player,"Shop open.");schedule(player) end
  return
 end
 if name=="NextCustomer" then
  if not s.shopOpen then
   s.shopOpen=true
   push(player,"Shop opened. Calling a customer.")
  end
  if s.working then push(player,"Freight shift active.");return end
  if s.customer then
   if s.customer.state~="Leave" then leave(player,"",nil,true) end
  else schedule(player) end
  return
 end
 if name=="PlaceItem" then
  if not Rules.integer(request.moveId,1,1000000000) then push(player,"Invalid move request."); return end
  local ok,message=Rules.move(s.profile,request.id,request.x,request.y,request.rotation,request.revision)
  if ok and s.customer then s.customer.quote=nil end
  push(player,message,request.moveId,ok); return
 end
 if name=="SetItemTag" then
  local ok,message=Rules.setItemTag(s.profile,request.id,request.qualityTag)
  if ok and s.customer then
   s.customer.quote=nil
   if s.customer.itemId==request.id then
    local item=Rules.find(s.profile,request.id)
    local value=Rules.value(item)
    s.customer.offer=math.max(1,math.floor(value*0.86))
    s.customer.budget=if s.customer.mode=="Buyer" then Rules.categoryBudget(s.customer.requestTag) else math.floor(value*1.35+math.max(0,s.profile.reputation)*2)
   end
  end
  push(player,message);return
 end
 if s.working then push(player,"Freight shift active."); return end
 if name=="DismissCustomer" then
  local c=matchingCustomer(s,request)
  if c then leave(player,"Customer dismissed.") else push(player,"No customer to dismiss.") end
  return
 end
 if name=="StageOffer" or name=="UnstageOffer" or name=="StageStock" or name=="UnstageStock" then
  if not Rules.integer(request.moveId,1,1000000000) then push(player,"Invalid drag request.");return end
  local c=matchingCustomer(s,request)
  if not c then push(player,"That visitor is no longer trading.",request.moveId,false);return end
  local ok,message
  if name=="StageOffer" then ok,message=Trade.stage(c,request.id,request.x,request.y,request.rotation,request.revision,s.profile,request.stockX,request.stockY,request.stockRotation)
  elseif name=="UnstageOffer" then ok,message=Trade.unstage(c,request.id,request.revision)
  elseif name=="StageStock" then ok,message=Trade.stageStock(s.profile,c,request.id,request.x,request.y,request.rotation,request.revision)
  else ok,message=Trade.unstageStock(s.profile,c,request.id,request.x,request.y,request.rotation,request.revision) end
  if ok and #c.basket>0 then ok,message=if c.mode=="Buyer" then Trade.reviewSale(s.profile,c,Http:GenerateGUID(false)) else Trade.review(s.profile,c,Http:GenerateGUID(false)) end
  push(player,message,request.moveId,ok);return
 elseif name=="ClearBasket" or name=="ReviewPurchase" or name=="ConfirmPurchase" or name=="BuyBulk" or name=="ReviewSale" or name=="ConfirmSale" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"That visitor is no longer trading.");return end
  local ok,message
  if name=="ClearBasket" then ok,message=Trade.clear(c)
  elseif name=="ReviewPurchase" then ok,message=Trade.review(s.profile,c,Http:GenerateGUID(false))
  elseif name=="BuyBulk" then
   local spent;ok,message,spent=Trade.buyBulk(s.profile,c,Http:GenerateGUID(false))
   if ok then local incident=Suspicion.spend(s.profile,spent or 0,os.time(),function(a: number,b: number) return rng:NextInteger(a,b) end);leave(player,message..(if incident then " "..incident else ""),"The whole haul is yours.");return end
  elseif name=="ReviewSale" then ok,message=Trade.reviewSale(s.profile,c,Http:GenerateGUID(false))
  elseif name=="ConfirmSale" then ok,message=Trade.confirmSale(s.profile,c,request.quoteId);if ok then leave(player,message,"I'll take these. Pleasure trading.");return end
  else
   local spent;ok,message,spent=Trade.confirm(s.profile,c,request.quoteId)
   if ok then local incident=Suspicion.spend(s.profile,spent or 0,os.time(),function(a: number,b: number) return rng:NextInteger(a,b) end);leave(player,message..(if incident then " "..incident else ""),"Deal. These goods are yours.");return end
  end
  push(player,message);return
 elseif name=="InspectGoods" then
  local c=matchingCustomer(s,request)
  if not c then push(player,"No visitor at the window.");return end
  for _,entry in ipairs(c.goods) do
   if entry.item.id==request.id then entry.item.inspected=true;push(player,"Visitor's merchandise inspected.");return end
  end
  push(player,"This item is not offered by the current visitor.");return
 end
 local ok,message=false,"That action is unavailable."
 local id=request.id
 if name=="Inspect" and type(id)=="string" and #id<=80 then ok,message=Rules.inspect(s.profile,id)
 elseif name=="Accept" or name=="Counter" then
  local c=matchingCustomer(s,request)
  if c then
   local selectedId=if type(request.id)=="string" then request.id else c.itemId
   local item=Rules.find(s.profile,selectedId)
   if item and Rules.matches(c,item) then
    if item.id~=c.itemId then
     c.itemId=item.id;c.kind=item.kind
     local value=Rules.value(item);c.offer=math.max(1,math.floor(value*0.86));c.budget=if c.mode=="Buyer" then Rules.categoryBudget(c.requestTag) else math.floor(value*1.35+math.max(0,s.profile.reputation)*2)
    end
    local price=c.offer; local exhausted=false
    if name=="Counter" then ok,message,exhausted=Rules.negotiate(s.profile,c,item,request.price);c.dialogue=message; price=request.price
    else ok=true end
    if ok then
     ok,message=Rules.sell(s.profile,c,item.id,price)
     if ok then leave(player,message,"Thanks, that is what I was looking for."); return end
    elseif exhausted then leave(player,message); return end
   end
  end
 elseif name=="Refuse" then
  if matchingCustomer(s,request) then leave(player,"You declined the deal."); return end
 elseif name=="Work" then
  if s.customer or s.profile.cash>=Rules.bill(s.profile) then message="Freight work is available when bills are unaffordable and the counter is clear."
  else
   s.working=true; s.epoch+=1; s.pendingArrival=false
   push(player,"Freight shift active.")
   task.delay(10,function()
    if sessions[player]~=s or s.closed then return end
    s.working=false; s.profile.cash+=18; s.profile.revenue+=18; s.profile.tradeProfit+=18
    Rules.log(s.profile,"Freight shift income +18")
    push(player,"Freight shift complete. Earned 18 Eddies."); schedule(player)
   end)
   return
  end
 end
 push(player,message)
 if ok then schedule(player) end
end)
local function join(player: Player)
 if closing or sessions[player] or loading[player] then return end
 loading[player]=true
 local profile,status=Persistence.load(player.UserId,Rules)
 if not profile then loading[player]=nil;if player.Parent then player:Kick(status) end; return end
 Suspicion.decay(profile,os.time())
 Machine.tick(profile,os.time(),function() return Http:GenerateGUID(false) end,function(a: number,b: number) return rng:NextInteger(a,b) end)
 local hasWallet=false
 for _,item in ipairs(profile.inventory) do if Items.Definitions[item.kind].walletTier~=nil then hasWallet=true;break end end
 if not hasWallet then
  local x,y,rotation=Grid.firstFit(profile,"wallet0")
  if x then table.insert(profile.inventory,{id=Http:GenerateGUID(false),kind="wallet0",paid=0,condition=100,authentic=true,restricted=false,inspected=false,qualityTag=Tags.DefaultQuality,gridX=x,gridY=y,rotation=rotation});profile.gridRevision+=1 end
 end
 loading[player]=nil
 if not player.Parent or closing then Persistence.save(player.UserId,profile,true); return end
 local slot=0
 while slots[slot] do slot+=1 end
 slots[slot]=true
 local origin=Vector3.new(slot*100,0,0)
 local stage=Scene.spawn(shopTemplate,workspace,origin,"Shop_"..player.UserId)
 sessions[player]={profile=profile,origin=origin,stage=stage,slot=slot,customer=nil,
  tokens=Config.RequestBurst,lastRequest=os.clock(),epoch=0,pendingArrival=false,
  saveStatus=status,closed=false,removing=false,working=false,shopOpen=false}
 push(player)
end
local function remove(player: Player)
 local s=sessions[player]
 if not s or s.removing then return end
 s.removing=true; s.closed=true; s.epoch+=1
 local ok,message=Persistence.save(player.UserId,s.profile,true)
 if not ok then warn("Latch Nine final save failed for "..player.UserId..": "..message) end
 s.stage:Destroy(); slots[s.slot]=nil; sessions[player]=nil
end
Players.PlayerAdded:Connect(join)
Players.PlayerRemoving:Connect(remove)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(join,player) end
task.spawn(function()
 while not closing do
  task.wait(5)
  for player,s in pairs(sessions) do
   if not s.closed then
    local now=os.time()
    local changed=Machine.tick(s.profile,now,function() return Http:GenerateGUID(false) end,function(a: number,b: number) return rng:NextInteger(a,b) end)
    changed=Suspicion.decay(s.profile,now) or changed
    if changed then push(player) end
   end
  end
 end
end)
task.spawn(function()
 while not closing do
  task.wait(Config.SaveInterval)
  for player,s in pairs(sessions) do
   if not s.closed then task.spawn(function()
    local ok,status=Persistence.save(player.UserId,s.profile,false)
    if sessions[player]~=s or s.closed then return end
    s.saveStatus=status; push(player)
    if not ok and not Persistence.safe(player.UserId) then
     s.closed=true; player:Kick("Save connection interrupted. Rejoin to protect your shop.")
    end
   end) end
  end
 end
end)
game:BindToClose(function()
 closing=true
 for player in pairs(sessions) do task.spawn(remove,player) end
 local deadline=os.clock()+25
 while (next(sessions) or next(loading)) and os.clock()<deadline do task.wait(0.1) end
end)
]]></string>
        </Properties>
