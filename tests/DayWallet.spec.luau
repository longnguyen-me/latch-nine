local config=require("../src/shared/Config")
local items=require("../src/shared/Items")
local tags=require("../src/shared/ItemTags")
local grid=require("../src/shared/Grid")(config,items.Definitions)
local rules=require("../src/server/Rules")(config,items.Definitions,grid,tags)
local p=rules.newProfile()
assert(#items.Definitions.wallet0.shape==6 and #items.Definitions.wallet1.shape==9 and #items.Definitions.wallet2.shape==12 and #items.Definitions.wallet3.shape==16)
local before=p.cash
assert(rules.endDay(p) and p.cash==before and p.day==2 and p.visits==0)
local saved=rules.newProfile()
table.insert(saved.inventory,{id="overlap",kind="blank1",paid=0,condition=100,authentic=true,restricted=false,inspected=false,qualityTag="standard",gridX=1,gridY=1,rotation=0})
assert(not rules.validate(saved))
local migrated=rules.migrate(saved)
assert(migrated and rules.validate(migrated) and migrated.cash==saved.cash and #migrated.inventory==2)
print("No-cost sleep, wallet footprints, and old layout repack passed")
